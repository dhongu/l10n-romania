<?xml version="1.0" ?>
<odoo>


    <record id="account_invoices_in_company_language" model="ir.actions.report">
        <field name="name">Invoices in company language</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ro_invoice_report_online.report_invoice_company_language</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment">(object.state == 'posted') and ((object.name or 'INV').replace('/','_')+'.pdf')
        </field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>


    <template id="report_invoice_company_language">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="res_company.partner_id.lang"/>
                <t
                    t-if="o._get_name_invoice_report() == 'account.report_invoice_document'"
                    t-call="account.report_invoice_document"
                    t-lang="lang"
                />
            </t>
        </t>
    </template>

    <template id="l10n_ro_report_invoice" inherit_id="account.report_invoice">
        <xpath expr="." position="inside">
            <t t-if="False">
                <t t-call="account.report_invoice_document"/>
            </t>
        </xpath>
    </template>
    <template id="header_invoice">
        <div id="address" class="address row" name="address">
            <t t-set="address_fields" t-value="['address']"/>
            <t t-set="res_company" t-value="o.company_id"/>
            <t t-if="res_company.x_l10n_ro_email_on_invoice_address">
                <t t-set="address_fields" t-value="address_fields + ['email']"/>
            </t>
            <t t-if="res_company.x_l10n_ro_phone_on_invoice_address">
                <t t-set="address_fields" t-value="address_fields + ['phone']"/>
            </t>
            <t t-set="no_marker" t-value="not res_company.x_l10n_ro_marker_on_invoice_address"/>

            <div name="information_block" class="col-6">
                <div>
                    <strong t-if="o.move_type in ['out_invoice', 'out_refund', 'out_receipt']">Supplier:
                    </strong>
                    <strong t-if="o.move_type in ['in_invoice', 'in_refund']">Customer:
                    </strong>
                    <strong id="company_name" t-field="res_company.partner_id.name"/>
                </div>
                <div id="company_address">
                    <div id="address_label" class="float-left mr-1">
                        <strong>Address:</strong>
                    </div>
                    <address
                        t-field="res_company.partner_id"
                        t-options='{"widget": "contact", "fields": address_fields, "no_marker": no_marker,
                            "no_tag_br": true}'
                    />
                </div>
                <t t-if="o.journal_id.x_l10n_ro_operating_unit_id">
                    <div>
                        <strong>Operating Unit:</strong>
                        <span t-field="o.journal_id.x_l10n_ro_operating_unit_id.name"/>
                    </div>
                    <div id="address_label" class="float-left mr-1">
                        <strong>Address:</strong>
                    </div>
                    <t t-set="journal" t-value="o.journal_id"/>
                    <address
                        t-field="journal.x_l10n_ro_operating_unit_id"
                        t-options='{"widget": "contact", "fields": address_fields, "no_marker": no_marker,
                            "no_tag_br": true}'
                    />
                </t>
                <div>
                    <t t-if="o.journal_id.x_l10n_ro_operating_unit_id and o.journal_id.x_l10n_ro_operating_unit_id.bank_ids">
                        <t t-set="partner_id" t-value="o.journal_id.x_l10n_ro_operating_unit_id"/>
                    </t>
                    <t t-else="">
                        <t t-set="partner_id" t-value="res_company.partner_id"/>
                    </t>
                    <t t-call="l10n_ro_report_common_online.banks"/>
                </div>

                <div>
                    <div t-if="res_company.partner_id.vat">
                        <strong>CIF:</strong>
                        <span t-field="res_company.partner_id.vat"/>
                    </div>
                    <div t-if="res_company.partner_id.nrc">
                        <strong>NRC:</strong>
                        <span t-field="res_company.partner_id.nrc"/>
                    </div>
                    <div t-if="res_company.x_l10n_ro_share_capital">
                        <strong>Share Capital:</strong>
                        <span t-out="int(res_company.x_l10n_ro_share_capital)"/>
                    </div>
                    <div t-if="'l10n_ro_vat_on_payment' in res_company.partner_id._fields">
                        <div t-if="res_company.partner_id.l10n_ro_vat_on_payment">
                            <span>Vat on payment</span>
                        </div>
                    </div>
                    <div>

                    </div>
                </div>

            </div>
            <div class="col-5 offset-1">
                <div>
                    <strong t-if="o.move_type in ['out_invoice', 'out_refund', 'out_receipt']">Customer:
                    </strong>
                    <strong t-if="o.move_type in ['in_invoice', 'in_refund']">Supplier:
                    </strong>
                    <strong id="partner_name" t-field="o.commercial_partner_id.name"/>
                </div>


                <div id="partner_address">
                    <div id="address_label" class="float-left mr-1">
                        <strong>Address:</strong>
                    </div>

                    <address
                        t-field="o.commercial_partner_id"
                        t-options='{"widget": "contact", "fields": address_fields, "no_marker": no_marker,
                            "no_tag_br": true}'
                    />
                </div>

                <t t-if="o.partner_shipping_id != o.commercial_partner_id">
                    <div id="partner_shipping_id">
                        <strong>Delivery address:</strong>
                        <address
                            t-field="o.partner_shipping_id"
                            t-options='{"widget": "contact", "fields": address_fields, "no_marker": no_marker, "no_tag_br": true}'
                        />
                    </div>
                </t>
                <div>
                    <t t-set="partner_id" t-value="o.commercial_partner_id"/>
                    <t t-call="l10n_ro_report_common_online.banks"/>
                </div>

                <div id="partner_cui">
                    <div t-if="o.commercial_partner_id.vat">
                        <strong>CIF:</strong>
                        <span t-field="o.commercial_partner_id.vat"/>
                    </div>
                    <div t-if="o.commercial_partner_id.nrc">
                        <strong>NRC:</strong>
                        <span t-field="o.commercial_partner_id.nrc"/>
                    </div>
                </div>
            </div>
        </div>
        <br/>
        <h2>
            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
            <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Proforma</span>
            <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
            <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">Credit Note</span>
            <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">Draft Credit Note</span>
            <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">Cancelled Credit Note</span>
            <span t-elif="o.move_type == 'out_receipt' and o.state == 'posted'">Sales Receipt</span>
            <span t-elif="o.move_type == 'out_receipt' and o.state == 'draft'">Draft Sales Receipt</span>
            <span t-elif="o.move_type == 'out_receipt' and o.state == 'cancel'">Cancelled Sales Receipt</span>
            <span t-elif="o.move_type == 'in_refund'">Vendor Credit Note</span>
            <span t-elif="o.move_type == 'in_invoice'">Vendor Bill</span>
            <span t-if="o.name != '/'" t-field="o.name"/>
            <span t-if="not o.name and o.move_type == 'out_invoice' and o.state == 'draft' and o.payment_reference" t-field="o.payment_reference"/>
        </h2>

    </template>

    <template id="l10n_ro_report_invoice_document" inherit_id="account.report_invoice_document" priority="100">
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title"/>
        </xpath>
        <!--
            20.0: the `information_block` and `address` blocks are no longer in a
            <div class="row"> of the t-call body, but t-set values of the template,
            passed as attributes to web.external_layout. They are emptied (as in 19,
            where their div was replaced) and the RO header goes at the start of the
            body, before the invoice_main div. The t-set nodes stay (empty), because
            other modules (account_edi_ubl_cii, l10n_it_edi, ...) xpath on them.
        -->
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block"/>
        </xpath>
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address"/>
        </xpath>
        <xpath expr="//div[hasclass('invoice_main')]" position="before">
            <t t-call="l10n_ro_invoice_report_online.header_invoice"/>
            <div style="visibility: hidden;height:1px;">
                <div class="row"/>
            </div>
        </xpath>
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="class">row mt-1 mb-1</attribute>
        </xpath>


        <!-- configurea coloanelor din tabelul de linii -->

        <!-- Adaugă coloana în antet, înainte de Description -->
        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_description']" position="before">
            <t t-if="o.company_id.x_l10n_ro_index_line_on_invoice">
                <th class="text-start">Ord</th>
                <t t-set="nr_crt" t-value="1"/>
            </t>
        </xpath>


        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_priceunit']/span" position="after">
            <br/>
            <span>(without taxes)</span>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_discount']" position="after">
            <th
                name="th_undiscounted_price"
                t-if="display_discount and res_company.x_l10n_ro_show_undiscounted_price_on_invoice"
                class="text-end"
            >
                <span>Price with disc.%</span>
            </th>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_subtotal']/span" position="after">
            <br/>
            <span>(without taxes)</span>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_subtotal']" position="after">
            <th name="th_price_taxes" class="text-end">
                <span>Taxes Values</span>
            </th>
            <th name="th_total_amount" class="text-end" t-if="res_company.x_l10n_ro_show_total_amount_with_taxes">
                <span>Total amount</span>
                <br/>
                <span>(with taxes)</span>
            </th>
        </xpath>


        <xpath expr="//table[@name='invoice_line_table']//tbody/t" position="before">
            <t t-set="current_subtotal_with_taxes" t-value="0"/>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']//tbody//t[@t-foreach='lines_to_report']/t" position="before">
            <t t-set="current_subtotal_with_taxes" t-value="current_subtotal_with_taxes + line.price_total"/>
        </xpath>


        <!-- Adaugă coloana pe fiecare linie de tip product, înainte de Description -->
        <xpath expr="//table[@name='invoice_line_table']//td[@name='account_invoice_line_name']" position="before">
            <t t-if="o.company_id.x_l10n_ro_index_line_on_invoice">
                <td class="text-start">
                    <span t-out="nr_crt"/>
                    <t t-set="nr_crt" t-value="nr_crt + 1"/>
                </td>
            </t>
        </xpath>

        <!-- Descriere -->
        <xpath expr="//table[@name='invoice_line_table']//td[@name='account_invoice_line_name']" position="replace">
            <td name="account_invoice_line_name">
                <t t-if="line.name">
                    <t t-if="res_company.x_l10n_ro_remove_product_name_from_invoice_line">
                        <!-- actually remove the product's display name, the description can have \n character -->
                        <t t-set="line_name" t-value="line.name"/>
                        <t t-set="product_name" t-value="line.product_id.display_name"/>
                        <t t-if="product_name and product_name in line_name and product_name != line_name">
                            <t t-set="line_name" t-value="line_name.replace(product_name, '',1).lstrip()"/>
                        </t>
                        <span t-out="line_name" style="white-space: pre-wrap;">Bacon Burger</span>
                    </t>
                    <t t-if="not res_company.x_l10n_ro_remove_product_name_from_invoice_line">
                        <!-- 20.0: `name` is only the description; `label` = product + description (the 19.0 `name`) -->
                        <span t-field="line.label" t-options="{'widget': 'text'}">Bacon Burger</span>
                    </t>
                </t>
                <t t-else="">
                    <t t-if="line.product_id">
                        <span t-field="line.product_id.display_name" t-options="{'widget': 'text'}">--</span>
                    </t>
                    <t t-else="">--</t>
                </t>

            </td>
        </xpath>

        <!-- Cantitate -->
        <xpath expr="//table[@name='invoice_line_table']//td[@name='td_quantity']" position="replace">
            <t t-set="signed_quantity" t-value="line.quantity"/>
            <t t-if="o.move_type == 'out_refund'">
                <t t-set="signed_quantity" t-value="-1*line.quantity"/>
            </t>
            <td name="td_quantity" class="o_td_quantity text-end">
                <span
                    t-out="signed_quantity"
                    t-options='{"widget": "float", "decimal_precision": "Product Unit of Measure"}'
                    class="text-nowrap"
                >3.00
                </span>
                <span t-field="line.product_uom_id" groups="uom.group_uom">units</span>
            </td>
        </xpath>
        <!-- Preț unitar fara taxe -->
        <xpath expr="//table[@name='invoice_line_table']//td[@name='td_price_unit']" position="replace">
            <t t-if="display_discount and res_company.x_l10n_ro_show_undiscounted_price_on_invoice">
                <t
                    t-set="price_unit_undiscounted"
                    t-value="line.tax_ids.compute_all(line.price_unit, currency=line.currency_id, quantity=1, handle_price_include=any(t.price_include for t in line.tax_ids))['total_excluded']"
                />
                <td>
                    <span
                        t-out="price_unit_undiscounted"
                        t-options='{"widget": "float", "precision": 2}'
                        class="text-nowrap"
                    />
                </td>
            </t>
            <t t-else="">

                <t t-set="price_unit_without_taxes" t-value="line.price_subtotal / (line.quantity or 1)" />
                <t
                    t-set="price_unit_without_taxes"
                    t-value="o.currency_id._convert(price_unit_without_taxes,currency_id, date=o.invoice_date)"
                />
                <td
                    name="td_price_unit"
                    t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
                >
                    <span
                        class="text-nowrap"
                        id="price_unit_without_taxes"
                        t-out="price_unit_without_taxes"
                        t-options='{"widget": "float", "precision": 2}'
                    >9.00
                    </span>
                </td>
            </t>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']//td[@name='td_discount']" position="after">
            <t t-if="display_discount and res_company.x_l10n_ro_show_undiscounted_price_on_invoice">
                <t t-set="price_unit_without_taxes" t-value="line.price_subtotal / (line.quantity or 1)" />
                <t
                    t-set="price_unit_without_taxes"
                    t-value="o.currency_id._convert(price_unit_without_taxes,currency_id, date=o.invoice_date)"
                />
                <td
                    name="td_price_unit"
                    t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
                >
                    <span
                        class="text-nowrap"
                        id="price_unit_without_taxes"
                        t-out="price_unit_without_taxes"
                        t-options='{"widget": "float", "precision": 2}'
                    >9.00
                    </span>
                </td>
            </t>
        </xpath>


        <xpath expr="//table[@name='invoice_line_table']//td[@name='td_subtotal']" position="after">

            <!-- Valoare TVA -->
            <td name="td_price_taxes" class="text-end">
                <t t-set="price_taxes" t-value="(line.price_total - line.price_subtotal )"/>
                <t t-if="o.move_type == 'out_refund'">
                    <t t-set="price_taxes" t-value="-1*price_taxes"/>
                </t>
                <t t-set="price_taxes" t-value="o.currency_id._convert(price_taxes,currency_id,date=o.invoice_date)"/>
                <span id="price_taxes" t-out="price_taxes" t-options='{"widget": "float", "precision": 2}'/>
            </td>

            <!-- Total (cu taxe) -->
            <td class="text-end" id="price_total" t-if="res_company.x_l10n_ro_show_total_amount_with_taxes">
                <t t-set="price_total" t-value="line.price_total"/>
                <t t-if="o.move_type == 'out_refund'">
                    <t t-set="price_total" t-value="-1*line.price_total"/>
                </t>
                <t t-set="price_total" t-value="o.currency_id._convert(price_total,currency_id,date=o.invoice_date)"/>
                <span id="price_total" t-out="price_total" t-options='{"widget": "float", "precision": 2}'/>
            </td>
        </xpath>

        <!-- Subtotal fara taxe -->
        <xpath expr="//table[@name='invoice_line_table']//td[@name='td_subtotal']" position="replace">
            <t t-set="signed_price_subtotal" t-value="line.price_subtotal"/>
            <t t-if="o.move_type == 'out_refund'">
                <t t-set="signed_price_subtotal" t-value="-1*line.price_subtotal"/>
            </t>
            <td name="td_subtotal" class="o_td_quantity text-end">
                <span t-out="signed_price_subtotal" t-options='{"widget": "float", "precision": 2}' class="text-nowrap">
                    27.0
                </span>
            </td>
        </xpath>







        <xpath expr="//p[@name='payment_communication']" position="after">
            <t t-if="not res_company.x_l10n_ro_hide_invoice_delegate">
                <div>
                    <strong>Elaborate:</strong>
                    <span t-field="o.user_id" />
                </div>
                <div>
                    <strong>Delegate:</strong>
                    <span t-field="o.x_l10n_ro_delegate_id" />
                </div>
                <div>
                    <strong>Mean Transport:</strong>
                    <span t-field="o.x_l10n_ro_mean_transp" />
                </div>
            </t>

            <!-- deliveries and receptions of the invoice, done -->
            <t t-set="pickings" t-value="[]"/>
            <t t-set="sale_lines" t-value="o.invoice_line_ids.sale_line_ids if 'sale_line_ids' in o.invoice_line_ids._fields else False"/>
            <t t-if="sale_lines and 'move_ids' in sale_lines._fields">
                <t t-set="pickings" t-value="sale_lines.move_ids.picking_id.filtered(lambda p: p.state == 'done')"/>
            </t>
            <t t-set="purchase_lines" t-value="o.invoice_line_ids.purchase_line_id if 'purchase_line_id' in o.invoice_line_ids._fields else False"/>
            <t t-if="purchase_lines and 'move_ids' in purchase_lines._fields">
                <t t-set="purchase_pickings" t-value="purchase_lines.move_ids.picking_id.filtered(lambda p: p.state == 'done')"/>
                <t t-set="pickings" t-value="(pickings | purchase_pickings) if pickings else purchase_pickings"/>
            </t>
            <div t-if="pickings and not res_company.x_l10n_ro_hide_pickings_in_invoice" name="pickings">
                <t t-if="o.move_type == 'in_invoice'">
                    <strong>Receptions:</strong>
                </t>
                <t t-set="awbs" t-value="[]"/>
                <t t-if="o.move_type == 'out_invoice'">
                    <strong>Deliveries:</strong>
                </t>
                <span class="m-0" t-foreach="pickings" t-as="d">
                    <span t-field="d.name"/>
                    <t t-if="'carrier_tracking_ref' in d._fields and d.carrier_tracking_ref">
                        <t t-set="awbs" t-value="awbs + [d.carrier_tracking_ref]"/>
                    </t>
                </span>
                <t t-if="awbs">
                    <br/>
                    <strong>AWB:</strong>
                    <span t-out="', '.join(awbs)"/>
                </t>
            </div>
        </xpath>

        <xpath expr="//p[@name='payment_communication']" position="attributes">
            <attribute name="t-if">not res_company.x_l10n_ro_hide_invoice_payment_communication</attribute>
        </xpath>


        <xpath expr="//div[@name='comment']" position="before">
            <div class="text-muted mb-3">
                <span t-if="o.move_type == 'out_invoice' or o.move_type == 'out_refund'" name="legal_text">
                    Invoice valid without signature and stamp according to art.V, paragraph (2) of Ordinance
                    no.17 / 2015, art. 319 paragraph (29) of Law no. 227/2015 on the Fiscal Code and
                    subsequent amendments.

                </span>
            </div>
            <div t-if="o.commercial_partner_id.x_l10n_ro_info_for_invoice" name="info_text">
                <span t-field="o.commercial_partner_id.x_l10n_ro_info_for_invoice"/>
            </div>

        </xpath>


        <xpath expr="//div[hasclass('page')]" position="after">
            <div t-if="o.company_id.x_l10n_ro_show_coface_logo" class="text-end mt-4" style="page-break-inside: avoid;">
                <img
                    src="/l10n_ro_invoice_report_online/static/src/img/Coface_logo.svg"
                    style="max-height: 50px;"
                    alt="Coface Logo"
                />
            </div>
            <t t-set="has_bf" t-value="o.move_type == 'out_invoice' and 'receipt_print' in o._fields and o.receipt_print" />

            <t t-if="(print_with_payments or o.move_type == 'out_receipt') and not has_bf">
                <t
                    t-set="payments_vals"
                    t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"
                />
                <!-- the journal type and the direction of each payment (computed in Python by l10n_ro_invoice_report) -->
                <t t-set="payments_vals_cash" t-value="[]"/>
                <t t-set="default_payment_type" t-value="{'out_invoice': 'inbound', 'out_receipt': 'inbound', 'in_refund': 'inbound', 'in_invoice': 'outbound', 'in_receipt': 'outbound', 'out_refund': 'outbound'}.get(o.move_type)"/>
                <t t-foreach="payments_vals" t-as="payment_vals">
                    <t t-set="pay_move" t-value="o.env['account.move'].browse(payment_vals.get('move_id'))"/>
                    <t t-set="journal_type" t-value="pay_move.journal_id.type"/>
                    <t t-set="payment_type" t-value="default_payment_type"/>
                    <t t-if="payment_vals.get('account_payment_id')">
                        <t t-set="payment_type" t-value="o.env['account.payment'].browse(payment_vals['account_payment_id']).payment_type"/>
                    </t>
                    <t t-elif="journal_type == 'sale' and payment_vals.get('pos_payment_name') and o.move_type == 'out_refund' and 'pos.payment.method' in o.env">
                        <t t-set="pos_method" t-value="o.env['pos.payment.method'].sudo().search([('name', '=', payment_vals['pos_payment_name'])], limit=1)"/>
                        <t t-if="pos_method">
                            <t t-set="journal_type" t-value="pos_method.journal_id.type"/>
                        </t>
                        <t t-set="payment_type" t-value="'outbound'"/>
                    </t>
                    <t t-if="journal_type == 'cash'">
                        <t t-set="payments_vals_cash" t-value="payments_vals_cash + [dict(payment_vals, journal_type=journal_type, payment_type=payment_type)]"/>
                    </t>
                </t>
                <t t-if="payments_vals_cash">
                    <br/>
                    <div
                        t-foreach="payments_vals_cash"
                        t-as="payment_vals"
                        style="page-break-inside: avoid; border: 1px solid black;padding: 15px;"
                    >


                        <t name="payment_container">
                            <t t-set="res_company" t-value="o.company_id"/>
                            <div>
                                <strong t-field="res_company.partner_id.name"/>
                            </div>
                            <div>
                                VAT:
                                <span t-field="res_company.partner_id.vat"/>
                            </div>
                            <div>
                                NRC:
                                <span t-field="res_company.partner_id.nrc"/>
                            </div>
                            <address
                                t-field="res_company.partner_id"
                                t-options='{"widget": "contact", "fields": ["address"], "no_marker": true, "no_tag_br": true}'
                            />
                            <h4>
                                <t t-if="payment_vals.get('payment_type') == 'inbound'">
                                    <span>Voucher:</span>
                                </t>
                                <t t-if="payment_vals.get('payment_type') == 'outbound'">
                                    <span>Payment disposal:</span>
                                </t>

                                <span t-out="payment_vals['ref']"/>
                                <span>/</span>
                                <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/>
                            </h4>
                            <div name="payment_text">
                                <t t-if="payment_vals.get('payment_type') == 'outbound'">
                                    <span>I payed to</span>
                                </t>
                                <t t-else="">
                                    <span>I received from</span>
                                </t>
                                <t t-set="partner" t-value="o.partner_id.commercial_partner_id"/>
                                <!-- on one line: whitespace before the commas would print "SRL , RO..." -->
                                <strong t-field="partner.name"/><t t-if="partner.vat">, <span t-field="partner.vat"/></t><t t-if="partner.nrc">, <span t-field="partner.nrc"/></t>,

                                <span t-if="partner.city" name="address">
                                    from
                                    <span t-field="partner.city"/>
                                    <span t-field="partner.street"/>
                                    <span t-field="partner.street2"/>
                                </span>

                                <span>amount</span>

                                <strong
                                    t-out="payment_vals['amount']"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                />
                                (
                                <t t-call="l10n_ro_report_common_online.amount_in_words" amount="payment_vals['amount']" currency="o.currency_id"/>
                                )
                            </div>
                            <div>
                                <t t-if="o.move_type == 'out_receipt'">Representing counter value of sales receipt</t>
                                <t t-else="">Representing counter value of invoice</t>
                                <span t-field="o.name"/>
                            </div>

                        </t>
                    </div>
                </t>
            </t>
        </xpath>
    </template>

    <template id="document_tax_totals_template" inherit_id="account.document_tax_totals_template" priority="100">
        <xpath expr="//tr[hasclass('o_subtotal')]/td[2]/span" position="before">
            <t t-if="o and o._name == 'account.move' and o.move_type in ['out_refund', 'in_refund']">
                <span>-</span>
            </t>
        </xpath>
        <xpath expr="//tr[hasclass('o_taxes')]/t/td[2]/span" position="before">
            <t t-if="o and o._name == 'account.move' and o.move_type in ['out_refund', 'in_refund']">
                <span>-</span>
            </t>
        </xpath>
        <xpath expr="//tr[hasclass('o_taxes')]/t[2]/td[2]/span" position="before">
            <t t-if="o and o._name == 'account.move' and o.move_type in ['out_refund', 'in_refund']">
                <span>-</span>
            </t>
        </xpath>
        <xpath expr="//tr[hasclass('o_total')]/td[2]/strong" position="before">
            <t t-if="o and o._name == 'account.move' and o.move_type in ['out_refund', 'in_refund']">
                <strong>-</strong>
            </t>
        </xpath>
    </template>

</odoo>
