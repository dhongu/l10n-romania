<?xml version="1.0" ?>
<odoo>
    <record id="l10n_ro_invoice_form_view" model="ir.ui.view">
        <field name="name">account.move.form.l10n_ro_invoice_report_online</field>
        <field name="model">account.move</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@id='header_left_group']"
                position="inside"
            >
                <field
                    name="x_l10n_ro_delegate_id"
                                        readonly="state!='draft'"
                    invisible="move_type!='out_invoice'"
                />
                <field name="x_l10n_ro_mean_transp" colspan="2" readonly="state!='draft'" invisible="move_type!='out_invoice'" />
                <field name="payment_reference" colspan="2" readonly="state!='draft'" invisible="move_type!='out_invoice'" />
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.move.select.l10n_ro_invoice_report_online</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <filter name="myinvoices" position="after">
                <separator />
                <filter
                    string="Due tomorrow"
                    name="tomorrow"
                    domain="[('invoice_date_due', '=', '+1d'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"
                />
                <filter
                    string="Due today"
                    name="today"
                    domain="[('invoice_date_due', '=', 'now'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"
                />
                <filter
                    string="Overdue 1-7 days"
                    name="7days"
                    domain="[('invoice_date_due', '&lt;=', 'now'), ('invoice_date_due', '&gt;=', '-7d'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"
                />
                <filter
                    string="Overdue 8-14 days"
                    name="7_14days"
                    domain="[('invoice_date_due', '&lt;=', '-8d'), ('invoice_date_due', '&gt;=', '-14d'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"
                />
                <filter
                    string="Overdue 15-30 days"
                    name="14_30days"
                    domain="[('invoice_date_due', '&lt;=', '-15d'), ('invoice_date_due', '&gt;=', '-30d'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"
                />
                <filter
                    string="Overdue more than 30 days"
                    name="30days"
                    domain="[('invoice_date_due', '&lt;', '-30d'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"
                />
            </filter>
        </field>
    </record>
</odoo>
