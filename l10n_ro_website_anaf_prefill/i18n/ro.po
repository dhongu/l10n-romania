#. module: l10n_ro_website_anaf_prefill
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf_prefill/static/src/interactions/anaf_lookup.esm.js:0
msgid "%s is struck off at ANAF: it cannot place an order."
msgstr "%s este radiată la ANAF: nu poate plasa o comandă."

#. module: l10n_ro_website_anaf_prefill
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf_prefill/static/src/interactions/anaf_lookup.esm.js:0
msgid "Fill in from ANAF"
msgstr "Completează din ANAF"

#. module: l10n_ro_website_anaf_prefill
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf_prefill/static/src/interactions/anaf_lookup.esm.js:0
msgid "The invoice is issued to %s"
msgstr "Factura se emite pe %s"

#. module: l10n_ro_website_anaf_prefill
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf_prefill/static/src/interactions/anaf_lookup.esm.js:0
msgid ""
"This company is fiscally inactive at ANAF. The order can be placed, but "
"while it is inactive the company cannot deduct the expense and the VAT of "
"the purchase."
msgstr ""
"Această firmă figurează ca inactivă fiscal la ANAF. Comanda poate fi "
"plasată, însă cât timp firma este inactivă nu își poate deduce cheltuiala și"
" TVA-ul aferente achiziției."

#. module: l10n_ro_website_anaf_prefill
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf_prefill/static/src/interactions/anaf_lookup.esm.js:0
msgid ""
"This looks like a personal numeric code (CNP). If you buy as an individual, "
"leave the field empty."
msgstr ""
"Acesta pare a fi un cod numeric personal (CNP). Dacă cumpărați ca persoană "
"fizică, lăsați câmpul gol."

#. module: l10n_ro_website_anaf_prefill
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf_prefill/static/src/interactions/anaf_lookup.esm.js:0
msgid "This tax code does not appear at ANAF."
msgstr "Acest cod fiscal nu apare la ANAF."

#. module: l10n_ro_website_anaf_prefill
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf_prefill/static/src/interactions/anaf_lookup.esm.js:0
msgid "VAT payer"
msgstr "plătitor de TVA"

#. module: l10n_ro_website_anaf_prefill
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf_prefill/static/src/interactions/anaf_lookup.esm.js:0
msgid "not a VAT payer"
msgstr "neplătitor de TVA"

#. module: l10n_ro_website_anaf_prefill
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf_prefill/static/src/interactions/anaf_lookup.esm.js:0
msgid "Looking up at ANAF…"
msgstr "Se caută la ANAF…"
