<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Shown only in the partner form opened from POS (context key set by l10n_ro_pos_partner_efactura) -->
    <record id="view_partner_form_pos_efactura_anaf" model="ir.ui.view">
        <field name="name">res.partner.form.pos.efactura.anaf</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="l10n_ro_pos_anaf_to_confirm" invisible="1" />
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="not context.get('pos_efactura_check') or not l10n_ro_pos_anaf_to_confirm"
                >
                    <strong>Data fetched from ANAF.</strong>
                    Check it against the customer's documents and save: the ANAF data is often
                    incomplete or outdated, and e-Factura (SPV) refuses an invoice with a wrong address.
                    <field
                        name="l10n_ro_pos_anaf_warnings"
                        nolabel="1"
                        class="d-block mt-2"
                        invisible="not l10n_ro_pos_anaf_warnings"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
