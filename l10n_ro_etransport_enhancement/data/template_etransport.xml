<odoo>

    <!-- Nativ (`l10n_ro_edi_stock`), secțiunea `documenteTransport` randează UN
         SINGUR document, luat dintr-un dict. Schema ANAF acceptă o listă (CMR +
         factură + aviz pe același transport), iar `_l10n_ro_edi_stock_get_template_data`
         din acest modul trece cheia pe listă — aici randăm câte un tag per document.

         ⚠️ Elementele din template-ul nativ sunt în namespace-ul default
         `mfp:anaf:dgti:eTransport:declaratie:v2` (declarat pe `<eTransport>`), deci
         xpath-ul simplu `//documenteTransport` NU le găsește — folosim `local-name()`.
         Elementul pe care îl inserăm declară același namespace, altfel lxml l-ar
         serializa cu `xmlns=""` și ANAF ar respinge declarația.

         `replace` e inevitabil (un tag unic devine un `t-foreach`), deci prioritate
         mare, ca moștenirea să se aplice după eventualele ajustări ale altor module. -->
    <template
        id="l10n_ro_template_etransport_documente"
        inherit_id="l10n_ro_edi_stock.l10n_ro_template_etransport"
        priority="99"
    >
        <xpath expr="//*[local-name()='documenteTransport']" position="replace">
            <t t-set="data_docs" t-value="data_notificare['documenteTransport']"/>
            <t t-if="not isinstance(data_docs, list)" t-set="data_docs" t-value="[data_docs]"/>
            <t t-foreach="data_docs" t-as="data_doc">
                <documenteTransport
                        xmlns="mfp:anaf:dgti:eTransport:declaratie:v2"
                        t-att-tipDocument="data_doc['tipDocument']"
                        t-att-dataDocument="data_doc['dataDocument']"
                        t-att-numarDocument="data_doc['numarDocument']"
                        t-att-observatii="data_doc.get('observatii') or False"/>
            </t>
        </xpath>
    </template>

    <!-- Corecția unei notificări și declarația post-avarie.

         Nativ, butonul „Amend” pune UIT-ul în `data['notificare']['uit']`, dar
         template-ul nu-l randează nicăieri. Fără elementul `corectie`, ANAF
         tratează XML-ul ca pe o notificare NOUĂ (Schematron BT-TY-002) și emite
         alt UIT, pe care nucleul îl ignoră: în SPV rămân două UIT-uri active, iar
         transferul îl arată pe cel vechi, cu datele necorectate.

         XSD-ul (`NotificareType`) cere `corectie` ca PRIM copil al `notificare`,
         deci îl inserăm înaintea primului copil existent; `position="inside"` l-ar
         pune la final și XML-ul ar fi respins de XSD.

         `declPostAvarie` e atribut pe rădăcina `eTransport` (BR-201: doar „D”). -->
    <template
        id="l10n_ro_template_etransport_corectie"
        inherit_id="l10n_ro_edi_stock.l10n_ro_template_etransport"
        priority="99"
    >
        <xpath expr="//*[local-name()='eTransport']" position="attributes">
            <attribute name="t-att-declPostAvarie">data.get('declPostAvarie')</attribute>
        </xpath>
        <xpath expr="//*[local-name()='notificare']/*[1]" position="before">
            <corectie
                xmlns="mfp:anaf:dgti:eTransport:declaratie:v2"
                t-if="data['send_type'] == 'amend' and data_notificare.get('uit')"
                t-att-uit="data_notificare['uit']"
            />
        </xpath>
    </template>

</odoo>
