<?xml version="1.0" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.uit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='shipping_connectors_setting_container']" position="after">
                <block title="UIT" name="uit_settings">
                    <setting
                        id="l10n_ro_etransport_get_order_value"
                        company_dependent="1"
                        help="Get UIT prices from sale/purchase orders"
                    >
                        <field name="l10n_ro_etransport_get_order_value" />
                    </setting>
                    <setting
                        id="l10n_ro_etransport_timeout"
                        company_dependent="1"
                        help="How long to wait for an answer from the ANAF eTransport API before giving up"
                    >
                        <field name="l10n_ro_etransport_timeout" class="o_light_label" /> s
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
