<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.l10n_ro_edi_stock</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="carrier_id" position="before">
                <field name="l10n_ro_edi_stock_required" />
                <field name="l10n_ro_transport_partner_id" invisible="not l10n_ro_edi_stock_required" />
            </field>
            <field name="l10n_ro_edi_stock_start_customs_office" position="after">
                <field
                    name="l10n_ro_etransport_start_address"
                    readonly="l10n_ro_edi_stock_fields_readonly"
                    invisible="picking_type_code != 'outgoing' or l10n_ro_edi_stock_operation_type != '30' or l10n_ro_edi_stock_start_loc_type != 'location'"
                />
            </field>
            <page name="etransport" position="inside">
                <group name="weights">
                    <field name="l10n_ro_shipping_weights" />
                    <group>
                        <field name="total_net_weight" invisible="not l10n_ro_shipping_weights" />
                        <field name="total_gross_weight" invisible="not l10n_ro_shipping_weights" />
                    </group>
                    <div class="alert alert-danger" role="alert" invisible="not l10n_ro_shipping_weight_lines_warning">
                        <field name="l10n_ro_shipping_weight_lines_warning" nolabel="1" />
                    </div>
                    <field
                        name="l10n_ro_shipping_weight_lines"
                        invisible="not l10n_ro_shipping_weights"
                        mode="list,kanban"
                    >
                        <list editable="bottom">
                            <field name="picking_id" column_invisible="1" />
                            <field
                                name="move_id"
                                domain="[('picking_id', '=', picking_id)]"
                                context="{'show_product_in_move': True}"
                            />
                            <field name="net_weight" sum="Total net" />
                            <field name="gross_weight" sum="Total gross" />
                            <field name="weight_uom_id" />
                        </list>
                    </field>
                    <div groups="base.group_user">
                        <button
                            name="l10n_ro_compute_weight_lines"
                            string="Get lines"
                            type="object"
                            class="btn-primary"
                            invisible="not l10n_ro_shipping_weights"
                        />
                        <button
                            name="l10n_ro_distribute_weights"
                            string="Distribute weights"
                            type="object"
                            class="btn-secondary"
                            invisible="not l10n_ro_shipping_weights"
                        />
                    </div>
                </group>
                <!-- Documentele însoțitoare cerute de ANAF (CMR, factură, aviz).
                     Fără niciun rând, se trimite documentul nativ: aviz cu
                     numărul transferului. -->
                <group name="l10n_ro_etransport_documents" string="Documente însoțitoare">
                    <field name="l10n_ro_etransport_document_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="document_type" />
                            <field name="name" />
                            <field name="date" />
                            <field name="remarks" optional="show" />
                        </list>
                    </field>
                    <button
                        name="l10n_ro_etransport_add_default_documents"
                        string="Preia documentele implicite"
                        type="object"
                        class="btn-secondary"
                        help="Adaugă avizul (numărul transferului) și, dacă există, facturile emise pe această livrare."
                    />
                </group>
            </page>
        </field>
    </record>
</odoo>
