msgid "eTransport Timeout (s)"
msgstr "Timp de așteptare eTransport (s)"

#. module: l10n_ro_etransport_enhancement
#: model:ir.model.fields,help:l10n_ro_etransport_enhancement.field_res_company__l10n_ro_etransport_timeout
msgid ""
"Maximum time to wait for an answer from the ANAF eTransport API. The Odoo "
"standard uses 10 seconds, which is often too short."
msgstr ""
"Timpul maxim de așteptare a răspunsului de la API-ul eTransport al ANAF. "
"Standardul Odoo folosește 10 secunde, deseori insuficient."

#. module: l10n_ro_etransport_enhancement
#: model_terms:ir.ui.view,arch_db:l10n_ro_etransport_enhancement.res_config_settings_view_form
msgid ""
"How long to wait for an answer from the ANAF eTransport API before giving up"
msgstr ""
"Cât se așteaptă răspunsul de la API-ul eTransport al ANAF înainte de "
"abandonare"
