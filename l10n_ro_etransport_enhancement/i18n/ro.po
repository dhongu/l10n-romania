msgid "%(location)s could not be determined from the linked orders."
msgstr "%(location)s nu a putut fi determinată din comenzile asociate."

#. module: l10n_ro_etransport_enhancement
#. odoo-python
#: code:addons/l10n_ro_etransport_enhancement/models/stock_picking_dropship.py:0
