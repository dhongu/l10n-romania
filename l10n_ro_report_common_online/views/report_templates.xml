<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Bank accounts of a partner (usually the company), for the header of the
        printed reports. Contract: receives `partner_id` (res.partner) and
        `res_company`; `o` (the document) is optional and gives the currency.
        Shows at most 3 accounts ticked "Romania - Print in Report", in the
        currency of the document (or of the company, when the document has none).
        In 20.0 res.partner.bank has no currency_id: the account currency is the
        one of the linked bank journal (journal_id), else the company currency.
    -->
    <template id="banks">
        <small>
            <t
                t-set="l10n_ro_doc_currency"
                t-value="(o.currency_id if o is not None and 'currency_id' in o._fields and o.currency_id else res_company.currency_id)"
            />
            <t
                t-set="l10n_ro_report_banks"
                t-value="partner_id.bank_ids.filtered(lambda b: b.x_l10n_ro_print_report and (b.journal_id[:1].currency_id or res_company.currency_id) == l10n_ro_doc_currency)[:3]"
            />
            <div t-foreach="l10n_ro_report_banks" t-as="bank">
                <div t-if="bank.bank_name">
                    <strong>Bank:</strong>
                    <span t-field="bank.bank_name" />
                </div>
                <div t-if="bank.account_number">
                    <strong>Account:</strong>
                    <span t-field="bank.account_number" />
                </div>
            </div>
        </small>
    </template>

    <!--
        Company identification block for the report header: name, address,
        bank accounts, Tax ID, NRC, share capital. Contract: receives
        `res_company`; when `o` has a company_id, that one wins.
    -->
    <template id="report_address_company">
        <t t-if="o is not None and 'company_id' in o._fields and o.company_id">
            <t t-set="res_company" t-value="o.company_id" />
        </t>
        <div>
            <div>
                <strong>Company</strong>
            </div>
            <strong t-field="res_company.partner_id.name" />
            <div>
                <strong>Address:</strong>
                <address
                    t-field="res_company.partner_id"
                    t-options='{"widget": "contact", "fields": ["address", "phone", "mobile", "fax"], "no_marker": false, "no_tag_br": true}'
                />
            </div>
        </div>
        <div>
            <t t-set="partner_id" t-value="res_company.partner_id" />
            <t t-call="l10n_ro_report_common_online.banks" />
        </div>
        <div>
            <div t-if="res_company.partner_id.vat">
                <strong t-out="(res_company.country_id.vat_label or 'Tax ID') + ':'" />
                <span t-field="res_company.partner_id.vat" />
            </div>
            <div t-if="res_company.partner_id.nrc">
                <strong>NRC:</strong>
                <span t-field="res_company.partner_id.nrc" />
            </div>
            <div t-if="res_company.x_l10n_ro_share_capital">
                <strong>Share Capital:</strong>
                <span t-out="int(res_company.x_l10n_ro_share_capital)" />
            </div>
        </div>
        <br />
    </template>
    <!--
        Amount in words, the way a Romanian receipt (chitanta) reads it:
        "cinci sute de lei si douazeci de bani". Contract: receives `amount`
        (float) and `currency` (res.currency). RON is spelled out in Romanian,
        whatever the print language; any other currency uses the standard
        Odoo wording. Written in QWeb (no Python), so it runs on Odoo Online.
    -->
    <template id="amount_in_words">
        <t t-if="currency.name != 'RON'">
            <t t-out="currency.amount_to_text(amount)" />
        </t>
        <t t-else="">
            <t t-set="ro_unit" t-value="lambda u, g: (('unu' if g != 'f' else 'una') if u == 1 else ('doi' if g == 'm' else 'două') if u == 2 else ['', '', '', 'trei', 'patru', 'cinci', 'șase', 'șapte', 'opt', 'nouă'][u])"/>
            <t t-set="ro_teen" t-value="lambda r, g: (('doisprezece' if g == 'm' else 'douăsprezece') if r == 12 else ['zece', 'unsprezece', '', 'treisprezece', 'paisprezece', 'cincisprezece', 'șaisprezece', 'șaptesprezece', 'optsprezece', 'nouăsprezece'][r - 10])"/>
            <t t-set="ro_tens" t-value="['', '', 'douăzeci', 'treizeci', 'patruzeci', 'cincizeci', 'șaizeci', 'șaptezeci', 'optzeci', 'nouăzeci']"/>
            <t t-set="ro_rest" t-value="lambda r, g: ('' if not r else ro_unit(r, g) if r &lt; 10 else ro_teen(r, g) if r &lt; 20 else ro_tens[r // 10] + ((' și ' + ro_unit(r % 10, g)) if r % 10 else ''))"/>
            <t t-set="ro_group" t-value="lambda n, g: ((('o sută' if n // 100 == 1 else ro_unit(n // 100, 'f') + ' sute') if n // 100 else '') + ' ' + ro_rest(n % 100, g)).strip()"/>
            <t t-set="ro_de" t-value="lambda n: ' de ' if n % 100 == 0 or n % 100 &gt;= 20 else ' '"/>
            <t t-set="ro_scale" t-value="lambda q, one, many, g: ('' if not q else one if q == 1 else ro_group(q, g) + ro_de(q) + many)"/>
            <t t-set="ro_words" t-value="lambda n, one, many: ('zero ' + many if not n else one if n == 1 else ' '.join((ro_scale(n // 1000000000 % 1000, 'un miliard', 'miliarde', 'n') + ' ' + ro_scale(n // 1000000 % 1000, 'un milion', 'milioane', 'n') + ' ' + ro_scale(n // 1000 % 1000, 'o mie', 'mii', 'f') + ' ' + ro_group(n % 1000, 'm') + ro_de(n) + many).split()))"/>
            <t t-set="ro_parts" t-value="('%.2f' % abs(currency.round(amount))).split('.')" />
            <t
                t-out="('minus ' if currency.round(amount) &lt; 0 else '') + ro_words(int(ro_parts[0]), 'un leu', 'lei') + ((' și ' + ro_words(int(ro_parts[1]), 'un ban', 'bani')) if int(ro_parts[1]) else '')"
            />
        </t>
    </template>
</odoo>
