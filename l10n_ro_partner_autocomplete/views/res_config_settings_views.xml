<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_anaf" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.partner.autocomplete.anaf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="partner_autocomplete.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="partner_autocomplete" position="inside">
                <div class="text-muted mt-2">
                    <i class="oi oi-filled me-1" data-icon="info" title="Info" />
                    Romanian companies (a CUI, with or without RO) are filled in from ANAF, without
                    IAP credits. The credits are used only for a search by name and for companies
                    from other countries.
                </div>
            </setting>
        </field>
    </record>
</odoo>
