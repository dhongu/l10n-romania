<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_anaf_refresh" model="ir.ui.view">
        <field name="name">res.partner.form.anaf.refresh</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="country_code" invisible="1" />
                <div
                    colspan="2"
                    class="d-flex justify-content-end"
                    invisible="not is_company or parent_id or country_code != 'RO' or not vat"
                >
                    <button
                        name="action_l10n_ro_anaf_refresh"
                        type="object"
                        string="Update from ANAF"
                        class="btn btn-link p-0"
                        icon="fa-refresh"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
