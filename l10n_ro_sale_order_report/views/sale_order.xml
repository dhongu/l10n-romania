<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="sale_order_company_data" inherit_id="sale.report_saleorder_document" priority="100">
        <!-- to do: de vazut de ce nu merge si de adus inapoi -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="o" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <t t-set="partner_id" t-value="o.partner_id" />
            <div id="address" class="address row">
                <div name="information_block" class="col-6">
                    <t t-call="l10n_ro_report_common.report_address_company" />
                </div>
                <div class="col-5 offset-1">
                    <div>
                        <strong>Customer</strong>
                    </div>
                    <div>
                        <strong t-field="doc.partner_id" />
                    </div>
                    <div>
                        <strong>Address:</strong>
                        <address
                            t-field="doc.partner_id"
                            t-options='{"widget": "contact", "fields": ["address","phone", "mobile", "fax"], "no_marker": false, "no_tag_br": true}'
                        />
                    </div>
                    <div t-if="doc.partner_id.vat">
                        <t t-esc="doc.company_id.country_id.vat_label or 'Tax ID'" />
                        :
                        <span t-field="doc.partner_id.vat" />
                    </div>
                </div>
            </div>
        </xpath>
        <!--Poze produse si nr. crt-->
        <xpath expr="//tbody/t" position="before">
            <t t-set="nr_crt" t-value="1" />
        </xpath>

        <xpath expr="//tbody/t/tr/t" position="inside">
            <t t-set="nr_crt" t-value="nr_crt + 1" />
        </xpath>
         <xpath expr="//th[@name='th_discount']" position="after">
                <th
                t-if="res_company.show_lead_time and any(line.customer_lead for line in doc.order_line)"
                name="th_terms"
                class="text-end"
            >Lead Time (days)</th>
            </xpath>
        <xpath expr="//td[@name='td_taxes']" position="before">
            <td
                t-if="res_company.show_lead_time and any(line.customer_lead for line in doc.order_line)"
                name="td_terms"
                class="text-end"
            >
                <span t-esc="round(line.customer_lead)" />
            </td>
        </xpath>
        <xpath expr="//table/thead/tr/th" position="before">
            <t t-if="res_company.counter_on_sale_order">
                <th name="th_number" class="text-start">No.</th>
            </t>
            <t t-if="res_company.include_image_line">
                <th />
            </t>
        </xpath>
        <td name="td_name" position="before">
            <t t-if="res_company.counter_on_sale_order">
                <td name="td_number">
                    <span t-esc="nr_crt" />
                </td>
            </t>
            <t t-if="res_company.include_image_line">
                <td name="td_image">
                    <img
                        t-if="line.product_id.image_256"
                        t-attf-src="#{image_data_uri(line.product_id.image_256)}"
                        alt="Image"
                        style="max-width:50px;"
                    />
                </td>
            </t>
        </td>
        <td name="td_name" position="replace">
            <td name="td_name">
                <t t-if="line.name">
                    <t t-if="res_company.exclude_product_name_from_description_offer">
                        <!-- actually remove the product's display name, the description can have \n character -->
                        <t t-set="line_name" t-value="line.name" />
                        <t t-set="product_name" t-value="line.product_id.display_name" />
                        <t t-if="product_name in line_name and product_name != line_name">
                            <t t-set="line_name" t-value="line_name.replace(product_name, '',1)" />
                        </t>
                        <span t-esc="line_name">Bacon Burger</span>
                    </t>
                    <t t-if="not res_company.exclude_product_name_from_description_offer">
                        <t t-if="res_company.make_description_smaller">
                            <span t-field="line.product_id.display_name">Bacon Burger</span>
                            <br />
                            <t t-set="line_name" t-value="line.name" />
                            <t t-set="product_name" t-value="line.product_id.display_name" />
                            <t t-set="line_name" t-value="line_name.replace(product_name, '',1)" />
                            <span t-esc="line_name" style="font-size: 85%;">Bacon Burger</span>
                        </t>
                        <t t-else="not res_company.make_description_smaller">
                            <span t-field="line.name">Bacon Burger</span>
                        </t>
                    </t>
                </t>


            </td>
        </td>

        <p id="fiscal_position_remark" position="before">
            <t t-set="transa" t-value="1" />
            <t t-if="doc.payment_term_id">
                <t t-if="len(doc.payment_term_id.line_ids)==2">
                    <t
                        t-set="terms"
                        t-value="doc.payment_term_id._compute_terms(date_ref=doc.date_order, currency=doc.currency_id, company=doc.company_id, tax_amount=doc.amount_tax, tax_amount_currency=doc.amount_tax, untaxed_amount=doc.amount_untaxed, untaxed_amount_currency=doc.amount_untaxed, sign=1)"
                    />
                    <div t-foreach="doc.payment_term_id._get_amount_by_date(terms).values()" t-as="term">
                        <span>Transa:</span>
                        <span t-esc="transa" />
                        Valoare:
                        <span t-esc="term['amount']" t-options='{"widget": "float", "precision": 2}' />
                        <t t-set="transa" t-value="transa+1" />
                    </div>
                </t>
            </t>
        </p>

        <xpath expr="//th[@name='th_subtotal']/span" position="after">
            <t t-if="res_company.show_total_amount_with_taxes_on_so">
                <br />
                <span>(without taxes)</span>
            </t>
        </xpath>

        <xpath expr="//th[@name='th_subtotal']" position="after">
            <th name="th_price_taxes" class="text-end" t-if="res_company.show_total_amount_with_taxes_on_so">
                <span>Taxes Values</span>
            </th>
            <th name="th_total_amount" class="text-end" t-if="res_company.show_total_amount_with_taxes_on_so">
                <span>Total amount</span>
                <br />
                <span>(with taxes)</span>
            </th>
        </xpath>

        <xpath expr="//td[@name='td_subtotal']" position="after">
            <t t-if="res_company.show_total_amount_with_taxes_on_so">
                <td name="td_price_taxes" class="text-end">
                    <t t-set="price_taxes" t-value="(line.price_total - line.price_subtotal )" />
                    <span id="price_taxes" t-esc="price_taxes" t-options='{"widget": "float", "precision": 2}' />
                </td>
                <td class="text-end" id="price_total">
                    <t t-set="price_total" t-value="line.price_total" />
                    <span id="price_total" t-esc="price_total" t-options='{"widget": "float", "precision": 2}' />
                </td>
            </t>
        </xpath>
    </template>


    <template id="saleorder_proforma_percent_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <t t-set="address">
                <div
                    t-field="doc.partner_id"
                    t-options='{"widget": "contact", "fields": ["address"], "no_marker": true, "no_tag_br": true}'
                />
                <p t-if="doc.partner_id.vat">
                    <t t-esc="doc.company_id.country_id.vat_label or 'Tax ID'" />
                    :
                    <span t-field="doc.partner_id.vat" />
                </p>
            </t>
            <t
                t-if="doc.partner_shipping_id == doc.partner_invoice_id
                                     and doc.partner_invoice_id != doc.partner_id
                                                  or doc.partner_shipping_id != doc.partner_invoice_id"
            >
                <t t-set="information_block">
                    <strong t-if="doc.partner_shipping_id == doc.partner_invoice_id">
                        Invoicing and Shipping Address:
                    </strong>
                    <strong t-if="doc.partner_shipping_id != doc.partner_invoice_id">Invoicing Address:</strong>
                    <div
                        t-field="doc.partner_invoice_id"
                        t-options='{"widget": "contact", "fields": ["address"], "no_marker": true, "no_tag_br": true}'
                    />
                    <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                        <strong>Shipping Address:</strong>
                        <div
                            t-field="doc.partner_shipping_id"
                            t-options='{"widget": "contact", "fields": ["address"], "no_marker": true, "no_tag_br": true}'
                        />
                    </t>
                </t>
            </t>
            <t t-set="percent" t-value="1" />
            <t t-set="adv_type" t-value="'percent'" />
            <t t-set="adv_value" t-value="0.0" />
            <t t-if="doc.payment_term_id">
                <t t-if="proforma_type == 'init'">
                    <t t-foreach="doc.payment_term_id.line_ids" t-as="payment_line">
                        <t t-set="p_type" t-value="payment_line.value" />
                        <t t-if="p_type == 'percent'">
                            <t t-set="percent" t-value="float(payment_line.value_amount/100)" />
                        </t>
                        <t t-if="p_type == 'fixed'">
                            <t t-set="percent" t-value="float((payment_line.value_amount/doc.amount_total))" />
                            <t t-set="adv_type" t-value="'fixed'" />
                            <t t-set="adv_value" t-value="payment_line.value_amount" />
                        </t>
                    </t>
                </t>
                <t t-if="proforma_type == 'final'">
                    <t t-if="doc.payment_amount">
                        <t t-set="percent" t-value="float((doc.amount_total-doc.payment_amount)/doc.amount_total)" />
                        <t t-set="adv_type" t-value="'fixed'" />
                        <t t-set="adv_value" t-value="doc.amount_total-doc.payment_amount" />
                    </t>
                    <t t-else="">
                        <t t-set="percent" t-value="1" />
                    </t>
                </t>
            </t>
            <div class="page">

                <h2 class="mt16">
                    <span>Pro-Forma Invoice #</span>
                    <span t-field="doc.name" />
                    <t t-if="proforma_type == 'final'">
                        <span>/2</span>
                    </t>
                </h2>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th name="th_description" class="text-left">Description</th>
                            <th name="th_quantity" class="text-end">Quantity</th>
                            <th name="th_priceunit" class="text-end">Unit Price</th>
                            <th name="th_taxes" class="text-end">Taxes</th>
                            <th name="th_subtotal" class="text-end">
                                <t groups="account.group_show_line_subtotals_tax_excluded">Amount</t>
                                <t groups="account.group_show_line_subtotals_tax_included">Total Price</t>
                                <t t-if="res_company.show_total_amount_with_taxes_on_so">
                                    <br />
                                    <span>(without taxes)</span>
                                </t>
                            </th>
                            <th
                                name="th_price_taxes"
                                class="text-end"
                                t-if="res_company.show_total_amount_with_taxes_on_so"
                            >
                                <span>Taxes Values</span>
                            </th>
                            <th
                                name="th_total_amount"
                                class="text-end"
                                t-if="res_company.show_total_amount_with_taxes_on_so"
                            >
                                <span>Total amount</span>
                                <br />
                                <span>(with taxes)</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <tr>
                            <td name="td_name">
                                <span>Advance</span>
                                <t t-if="adv_type == 'percent'">
                                    <span t-esc="round(percent * 100)" />
                                    %
                                </t>
                                <t t-if="adv_type == 'fixed'">
                                    <span
                                        t-esc="adv_value"
                                        t-options="{'widget': 'monetary', 'display_currency': doc.pricelist_id.currency_id}"
                                    />
                                </t>
                                <span>according to Order #</span>
                                <span t-field="doc.name" />
                            </td>
                            <td name="td_quantity" class="text-end">
                                <span>1</span>
                            </td>
                            <td name="td_priceunit" class="text-end">
                                <t t-set="untaxed_amount" t-value="doc.amount_untaxed * percent" />
                                <span
                                    t-esc="untaxed_amount"
                                    t-options="{'widget': 'monetary', 'display_currency': doc.pricelist_id.currency_id}"
                                />
                            </td>
                            <td name="td_taxes" class="text-end">
                                <t t-set="amount_taxes" t-value="doc.amount_tax * percent" />
                                <span
                                    t-esc="amount_taxes"
                                    t-options="{'widget': 'monetary', 'display_currency': doc.pricelist_id.currency_id}"
                                />
                            </td>
                            <td name="td_subtotal" class="text-right o_price_total">
                                <t t-set="total_amount" t-value="doc.amount_total * percent" />
                                <span
                                    t-esc="total_amount"
                                    t-options="{'widget': 'monetary', 'display_currency': doc.pricelist_id.currency_id}"
                                />
                            </td>
                            <t t-if="res_company.show_total_amount_with_taxes_on_so">
                                <td name="td_price_taxes" class="text-end">
                                    <t t-set="price_taxes" t-value="doc.amount_tax * percent" />
                                    <span
                                        id="price_taxes"
                                        t-esc="price_taxes"
                                        t-options='{"widget": "float", "precision": 2}'
                                    />
                                </td>
                                <td class="text-end" id="price_total">
                                    <t t-set="price_total" t-value="doc.amount_total * percent" />
                                    <span
                                        id="price_total"
                                        t-esc="price_total"
                                        t-options='{"widget": "float", "precision": 2}'
                                    />
                                </td>
                            </t>
                        </tr>
                        <tr name="order_details">
                            <td name="td_name_details" colspan="3" class="  o_price_total">
                                <span style="font-size:12px">
                                    <t t-foreach="doc.order_line" t-as="line">
                                        <span t-field="line.product_uom_qty" />
                                        <span t-field="line.product_uom" />
                                        <span>x</span>
                                        <span t-field="line.name" />
                                        <br />
                                    </t>
                                    <span>Total amount of order:</span>
                                    <span t-field="doc.amount_total" />
                                    <br />
                                    <span>To pay:</span>
                                    <t t-set="total_amount" t-value="doc.amount_total * percent" />
                                    <span
                                        t-esc="total_amount"
                                        t-options="{'widget': 'monetary', 'display_currency': doc.pricelist_id.currency_id}"
                                    />
                                </span>
                            </td>
                            <td class="text-right o_price_total">

                            </td>
                            <td class="text-right o_price_total">

                            </td>
                            <t t-if="res_company.show_total_amount_with_taxes_on_so">
                                <td class="text-right o_price_total" />
                                <td class="text-right o_price_total" />
                            </t>
                        </tr>
                    </tbody>
                </table>
                <div class="clearfix" name="so_total_summary">
                    <div id="total" class="row mt-n3" name="total">
                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                            <table class="o_total_table table table-borderless">
                                <!-- Tax totals -->
                                <t t-call="sale.document_tax_totals">
                                    <t t-set="tax_totals" t-value="doc.tax_totals" />
                                    <t t-set="currency" t-value="doc.currency_id" />
                                </t>
                            </table>
                        </div>
                    </div>
                </div>
                <div id="oe_structure" />
            </div>
        </t>
    </template>

    <template id="saleorder_proforma_percent_init">
        <t t-call="web.html_container">
            <t t-set="proforma_type" t-value="'init'" />
            <t t-foreach="docs" t-as="doc">
                <t
                    t-call="l10n_ro_sale_order_report.saleorder_proforma_percent_document"
                    t-lang="doc.partner_id.lang"
                />
            </t>
        </t>
    </template>
    <template id="saleorder_proforma_percent_final">
        <t t-call="web.html_container">
            <t t-set="proforma_type" t-value="'final'" />
            <t t-foreach="docs" t-as="doc">
                <t
                    t-call="l10n_ro_sale_order_report.saleorder_proforma_percent_document"
                    t-lang="doc.partner_id.lang"
                />
            </t>
        </t>
    </template>


    <record id="action_report_percent_proforma_init" model="ir.actions.report">
        <field name="name">Percent Proforma - first</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ro_sale_order_report.saleorder_proforma_percent_init</field>
        <field name="report_file">l10n_ro_sale_order_report.saleorder_proforma_percent_init</field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_type">report</field>
    </record>


    <record id="action_report_percent_proforma_final" model="ir.actions.report">
        <field name="name">Percent Proforma - last</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ro_sale_order_report.saleorder_proforma_percent_final</field>
        <field name="report_file">l10n_ro_sale_order_report.saleorder_proforma_percent_final</field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_type">report</field>
    </record>


</odoo>
