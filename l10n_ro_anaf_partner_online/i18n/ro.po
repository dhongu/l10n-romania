#. module: l10n_ro_anaf_partner_online
#. odoo-javascript
#: code:addons/l10n_ro_anaf_partner_online/static/src/js/anaf_lookup_widget.esm.js:0
msgid ""
"The ANAF service is not active yet: Contacts > Configuration > ANAF > ANAF "
"Service, Activate."
msgstr ""
"Serviciul ANAF nu este încă activ: Contacte > Configurare > ANAF > Serviciul"
" ANAF, Activează."

#. module: l10n_ro_anaf_partner_online
#. odoo-javascript
#: code:addons/l10n_ro_anaf_partner_online/static/src/js/anaf_lookup_widget.esm.js:0
msgid ""
"The service did not answer at once: the request is queued and the partner is"
" updated in a few seconds."
msgstr ""
"Serviciul nu a răspuns imediat: cererea a intrat în coadă, iar partenerul se"
" actualizează în câteva secunde."

