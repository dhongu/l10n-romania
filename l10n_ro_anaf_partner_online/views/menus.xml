<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_anaf_service" model="ir.actions.act_window">
        <field name="name">ANAF Service</field>
        <field name="res_model">x_iap_online_service</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="iap_online_service_anaf" />
    </record>
    <record id="action_anaf_requests" model="ir.actions.act_window">
        <field name="name">ANAF Requests</field>
        <field name="res_model">x_iap_online_request</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('x_service_id', '=', ref('iap_online_service_anaf'))]" />
    </record>
    <menuitem
        id="menu_anaf_online_root"
        name="ANAF"
        parent="contacts.res_partner_menu_config"
        sequence="90"
        groups="base.group_partner_manager"
    />
    <menuitem
        id="menu_anaf_service"
        name="ANAF Service"
        parent="menu_anaf_online_root"
        action="action_anaf_service"
        sequence="10"
    />
    <menuitem
        id="menu_anaf_requests"
        name="ANAF Requests"
        parent="menu_anaf_online_root"
        action="action_anaf_requests"
        sequence="20"
    />
</odoo>
