<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_x_tb_service_request_list" model="ir.ui.view">
        <field name="name">x_tb_service_request.list</field>
        <field name="model">x_tb_service_request</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="x_state == 'error'" decoration-info="x_state == 'sent'">
                <field name="create_date" />
                <field name="x_service" />
                <field name="x_input" />
                <field name="x_partner_id" />
                <field name="x_state" />
                <field name="x_error" />
            </list>
        </field>
    </record>
    <record id="view_x_tb_service_request_form" model="ir.ui.view">
        <field name="name">x_tb_service_request.form</field>
        <field name="model">x_tb_service_request</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="x_service" />
                            <field name="x_input" />
                            <field name="x_partner_id" />
                        </group>
                        <group>
                            <field name="x_state" />
                            <field name="x_error" />
                            <field name="create_date" />
                        </group>
                    </group>
                    <group groups="base.group_no_one">
                        <field name="x_token" />
                        <field name="x_callback_url" />
                        <field name="x_result" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_x_tb_service_request" model="ir.actions.act_window">
        <field name="name">ANAF Requests</field>
        <field name="res_model">x_tb_service_request</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_anaf_online_root"
        name="ANAF"
        parent="contacts.res_partner_menu_config"
        sequence="90"
        groups="base.group_partner_manager"
    />
    <menuitem
        id="menu_x_tb_service_request"
        name="ANAF Requests"
        parent="menu_anaf_online_root"
        action="action_x_tb_service_request"
        sequence="10"
    />
    <menuitem
        id="menu_tb_activate"
        name="Activate ANAF Service"
        parent="menu_anaf_online_root"
        action="action_tb_activate"
        sequence="20"
        groups="base.group_system"
    />
</odoo>
