<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.anaf.online</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- The button on the row of the Tax ID (div#vat_div is already a row on 20.0) -->
            <xpath expr="//div[@id='vat_div']/field[@name='vat']" position="after">
                <widget name="tb_anaf_lookup" invisible="not is_company and parent_id" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="ANAF" name="anaf" invisible="not x_anaf_last_check">
                    <group>
                        <group>
                            <field name="x_anaf_vat_payer" />
                            <field name="x_anaf_inactive" />
                            <field name="x_anaf_struck_off" />
                        </group>
                        <group>
                            <field name="x_anaf_trade_register" />
                            <field name="x_anaf_last_check" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
