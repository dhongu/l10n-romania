<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="l10n_ro_anaf_partner_online.AnafLookupWidget">
        <button
            type="button"
            class="btn btn-sm btn-secondary o_tb_anaf_lookup"
            t-att-disabled="state.busy or props.readonly"
            t-on-click="onClick"
            title="Fill in the partner from ANAF by its CUI"
        >
            <i t-attf-class="fa {{ state.busy ? 'fa-spinner fa-spin' : 'fa-search' }} me-1" />
            ANAF
        </button>
    </t>
</templates>
