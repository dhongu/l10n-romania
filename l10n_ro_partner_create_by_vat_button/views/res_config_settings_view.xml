<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.partner.lock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ro_config.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='modules_contact_setting_container']" position="inside">
                <setting string="Partner Lock" help="Lock partner type and VAT if invoices exist.">
                    <field name="partner_lock_with_invoice" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
