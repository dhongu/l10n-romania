<odoo>
    <!-- List View pentru Registru de Casa -->
    <record id="view_cash_register_tree" model="ir.ui.view">
        <field name="name">cash.register.tree</field>
        <field name="model">l10n.ro.cash.register</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_print" string="Print" type="object" icon="print" />
                    <button name="action_refresh" string="Refresh" type="object" />
                </header>
                <field name="name" />
                <field name="date" />
                <field name="journal_id" />
                <field name="balance_start" />
                <field name="balance_end" />
                <field name="count_difference" optional="hide" />
                <field name="count_currency_id" column_invisible="1" />
                <field name="currency_id" column_invisible="1" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'closed'"
                    decoration-info="state == 'open'"
                    optional="show"
                />
                <field name="activity_ids" widget="list_activity" optional="hide" />
            </list>
        </field>
    </record>

    <!-- Form View pentru Registru de Casa -->
    <record id="view_cash_register_form" model="ir.ui.view">
        <field name="name">cash.register.form</field>
        <field name="model">l10n.ro.cash.register</field>
        <field name="arch" type="xml">
            <form string="Cash Register">
                <header>
                    <button name="action_print" string="Print" type="object" icon="print" />
                    <button name="action_refresh" string="Refresh" type="object" />
                    <button name="action_receipt" string="Add Receipt" type="object" invisible="state == 'closed'" />
                    <button name="action_payment" string="Add Payment" type="object" invisible="state == 'closed'" />
                    <button name="action_operation" string="Operation" type="object" invisible="state == 'closed'" />
                    <button
                        name="action_count_cash"
                        string="Count Cash"
                        type="object"
                        icon="attach_money"
                        invisible="state == 'closed'"
                    />
                    <button
                        name="action_record_difference"
                        string="Record Difference"
                        type="object"
                        invisible="state == 'closed' or not is_counted or count_difference == 0"
                    />
                    <button
                        name="action_print_cash_count"
                        string="Print Cash Count"
                        type="object"
                        icon="print"
                        invisible="not is_counted"
                    />
                    <button
                        name="action_close"
                        string="Close Day"
                        type="object"
                        class="btn-primary"
                        invisible="state == 'closed'"
                        confirm="After closing, no entry on the cash account can be dated on this day or earlier until the day is reopened. Close the day?"
                    />
                    <button
                        name="action_reopen"
                        string="Reopen"
                        type="object"
                        invisible="state != 'closed'"
                        confirm="The later closed days of this cash desk are reopened too. Reopen?"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title oe_inline">
                        <label for="name" />
                        <h1><field name="name" placeholder="e.g. CAS/2021/0001" readonly="state == 'closed'" /></h1>
                    </div>
                    <group>
                       <group>
                            <field name="date" readonly="state == 'closed'" />
                            <field name="journal_id" readonly="state == 'closed'" />
                            <field name="currency_id" />
                            <field name="company_id" groups="base.group_multi_company" optional="show" />
                        </group>
                        <group>
                            <field name="balance_start" />
                            <field name="balance_end" />
                            <field name="is_counted" invisible="1" />
                            <field name="count_currency_id" invisible="1" />
                            <field name="count_book_balance" invisible="not is_counted or count_currency_id == currency_id" />
                            <field name="counted_amount" invisible="not is_counted" />
                            <field
                                name="count_difference"
                                invisible="not is_counted"
                                decoration-danger="count_difference &lt; 0"
                                decoration-success="count_difference &gt; 0"
                            />
                            <field name="closed_balance" invisible="state != 'closed'" />
                            <field name="closed_by_id" invisible="state != 'closed'" />
                            <field name="closed_on" invisible="state != 'closed'" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Cash Register Lines">
                            <field name="move_line_ids">
                                <list>
                                    <field name="move_name" string="Journal Entry" widget="open_move_widget" />
                                    <field name="partner_id" />
                                    <field name="balance" sum="Total Amount" string="Total" decoration-bf="1" />
                                    <field name="currency_id" column_invisible="1" />
                                    <button
                                        name="print_cash_operation"
                                        string="Print"
                                        type="object"
                                        icon="print"
                                        invisible="1"
                                    />
                                    <field name="ref" />
                                </list>
                            </field>
                        </page>
                        <page string="Cash Count" name="cash_count" invisible="not is_counted">
                            <field name="count_line_ids" readonly="state == 'closed'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="denomination_id" readonly="1" />
                                    <field name="kind" />
                                    <field name="quantity" />
                                    <field name="amount" sum="Counted Cash" decoration-bf="1" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True" />
            </form>
        </field>
    </record>

    <record id="view_cash_register_search" model="ir.ui.view">
        <field name="name">cash.register.search</field>
        <field name="model">l10n.ro.cash.register</field>
        <field name="arch" type="xml">
            <search>
                <field name="journal_id" string="Journal" />
                <field
                    name="move_line_ids"
                    string="Partner"
                    filter_domain="[('move_line_ids.partner_id', 'ilike', self)]"
                />
                <separator />
                <field name="date" string="Period" />
                <filter string="Open" name="open" domain="[('state', '=', 'open')]" />
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]" />

                <filter string="Date" name="date" date="date" />
                <group>
                    <filter string="Journal" name="group_by_journal" context="{'group_by': 'journal_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Actiune pentru vizualizarea registrelor de casa -->
    <record id="action_cash_register" model="ir.actions.act_window">
        <field name="name">Cash Register</field>
        <field name="res_model">l10n.ro.cash.register</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_cash_register_tree" />
    </record>


    <menuitem
        id="menu_cash_register"
        name="Cash register"
        parent="account.account_transactions_menu"
        groups="account.group_account_manager"
        action="action_cash_register"
        sequence="10"
    />


    <record id="action_generate_missing_cash_register" model="ir.actions.server">
        <field name="name">Generate Missing Cash Register</field>
        <field name="model_id" ref="account.model_account_journal" />
        <field name="binding_model_id" ref="account.model_account_journal" />
        <field name="state">code</field>
        <field name="code">record.generate_missing_cash_register()</field>
    </record>

    <record id="action_remove_outstanding_accounts" model="ir.actions.server">
        <field name="name">Remove Outstanding Accounts</field>
        <field name="model_id" ref="account.model_account_journal" />
        <field name="binding_model_id" ref="account.model_account_journal" />
        <field name="state">code</field>
        <field name="code">record.remove_outstanding_accounts()</field>
    </record>

</odoo>
