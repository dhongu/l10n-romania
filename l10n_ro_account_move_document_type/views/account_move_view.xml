<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ro.document.type</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref'][@invisible=&quot;move_type != 'entry'&quot;]" position="after">
                <field name="l10n_ro_document_type" invisible="move_type != 'entry'" />
            </xpath>
        </field>
    </record>

    <record id="view_move_tree" model="ir.ui.view">
        <field name="name">account.move.list.l10n.ro.document.type</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree" />
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="l10n_ro_document_type" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_account_move_filter" model="ir.ui.view">
        <field name="name">account.move.search.l10n.ro.document.type</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter" />
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="l10n_ro_document_type" />
            </field>
            <xpath expr="//filter[@name='journal']" position="after">
                <filter
                    string="Document Type"
                    name="l10n_ro_document_type_group"
                    context="{'group_by': 'l10n_ro_document_type'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
