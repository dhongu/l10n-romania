<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Conturile bancare ale unui partener (de regulă compania), pentru antetul
        rapoartelor tipărite. Contract: primește `partner_id` (res.partner) și
        `res_company` din context; `o` (documentul) este opțional și dă moneda.
        Se afișează cel mult 3 conturi bifate "Print in Report", în moneda
        documentului (sau a companiei, dacă documentul nu are monedă).
    -->
    <template id="banks">
        <small>
            <t
                t-set="l10n_ro_doc_currency"
                t-value="(o.currency_id if o is not None and 'currency_id' in o._fields and o.currency_id else res_company.currency_id)"
            />
            <t
                t-set="l10n_ro_report_banks"
                t-value="partner_id.bank_ids.filtered(lambda b: b.l10n_ro_print_report and (b.currency_id or res_company.currency_id) == l10n_ro_doc_currency)[:3]"
            />
            <div t-foreach="l10n_ro_report_banks" t-as="bank">
                <div t-if="bank.bank_name">
                    <strong>Bank:</strong>
                    <span t-field="bank.bank_name" />
                </div>
                <div t-if="bank.acc_number">
                    <strong>Account:</strong>
                    <span t-field="bank.acc_number" />
                </div>
            </div>
        </small>
    </template>

    <!--
        Blocul de identificare a companiei pentru antetul rapoartelor: denumire,
        adresă, conturi bancare, CUI, NRC, capital social. Contract: primește
        `res_company`; dacă `o` are company_id, aceea are prioritate.
    -->
    <template id="report_address_company">
        <t t-if="o is not None and 'company_id' in o._fields and o.company_id">
            <t t-set="res_company" t-value="o.company_id" />
        </t>
        <div>
            <div>
                <strong>Company</strong>
            </div>
            <strong t-field="res_company.partner_id.name" />
            <div>
                <strong>Address:</strong>
                <address
                    t-field="res_company.partner_id"
                    t-options='{"widget": "contact", "fields": ["address", "phone", "mobile", "fax"], "no_marker": false, "no_tag_br": true}'
                />
            </div>
        </div>
        <div>
            <t t-set="partner_id" t-value="res_company.partner_id" />
            <t t-call="l10n_ro_report_common.banks" />
        </div>
        <div>
            <div t-if="res_company.partner_id.vat">
                <strong>
                    <t t-esc="res_company.country_id.vat_label or 'Tax ID'" />
                    :
                </strong>
                <span t-field="res_company.partner_id.vat" />
            </div>
            <div t-if="res_company.partner_id.nrc">
                <strong>NRC:</strong>
                <span t-field="res_company.partner_id.nrc" />
            </div>
            <div t-if="res_company.l10n_ro_share_capital">
                <strong>Share Capital:</strong>
                <span t-esc="int(res_company.l10n_ro_share_capital)" />
            </div>
        </div>
        <br />
    </template>
</odoo>
