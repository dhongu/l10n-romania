<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_category_store_form" model="ir.ui.view">
        <field name="name">product.category.store.form</field>
        <field name="model">product.category</field>
        <field
            name="inherit_id"
            ref="l10n_ro_stock_account.view_product_category_add_romania_form"
        />
        <field name="arch" type="xml">
            <field name="l10n_ro_stock_account_change" position="after">
                <field
                    name="l10n_ro_property_store_markup_account_id"
                    options="{'no_create': True}"
                />
                <field
                    name="l10n_ro_property_store_uneligible_tax_account_id"
                    options="{'no_create': True}"
                />
            </field>
        </field>
    </record>
</odoo>
