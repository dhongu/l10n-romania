<?xml version="1.0" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting help="Show marker on invoice address">
                    <field name="marker_on_invoice_address" />
                </setting>
                <setting help="Show email on invoice address">
                    <field name="email_on_invoice_address" />
                </setting>
                <setting help="Show phone on invoice address">
                    <field name="phone_on_invoice_address" />
                </setting>
                <setting help="Show index line on invoicee">
                    <field name="index_line_on_invoice" />
                </setting>
                <setting help="Show total amount with taxes on invoice">
                    <field name="show_total_amount_with_taxes" />
                </setting>
                <setting help="Hide invoice payment communication">
                    <field name="hide_invoice_payment_communication" />
                </setting>
                <setting help="Hide picking on invoice">
                    <field name="hide_pickings_in_invoice" />
                </setting>
                <setting help="Remove product name from invoice lines">
                    <field name="remove_product_name_from_invoice_line" />
                </setting>
                <setting help="Show delegate on invoices">
                    <field name="show_invoice_delegate" />
                </setting>
                <setting help="Show undiscounted price on invoices">
                    <field name="show_undiscounted_price_on_invoice" />
                </setting>
                <setting help="Display the Coface logo at the end of the invoice to indicate that the debt is insured by Coface (trade credit insurance).">
                    <field name="show_coface_logo" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
