                               <t
                                   t-if="current_section and (l_last or lines[l_index+1].display_type == 'line_section')"
                                   id="final_section"
                               >
                                   <tr class="is-subtotal text-end">
                                       <td colspan="99">
                                           <strong class="mr16">Subtotal</strong>
                                           <span
                                               t-esc="current_subtotal"
                                               t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"
                                           />
                                       </td>
                                   </tr>
                               </t>
                           </t>
                       </tbody>
                   </table>
               </xpath>
         -->


        <xpath expr="//div[@id='total']/div" position="replace">
        </xpath>

        <xpath expr="//div[@id='total']/.." position="before">
            <div class="row">
                <div class="col-7" t-if="o.move_type == 'out_invoice' or o.move_type == 'out_refund' ">
                    <table
                        id="signature"
                        class="o_total_table table table-borderless mb-0"
                        style="page-break-inside: avoid;"
                    >
                        <tr>
                            <td>Elaborate:</td>
                            <td>Information for delivery:</td>
                        </tr>
                        <tr>
                            <td>
                                <span>Name:</span>
                                <span t-field="o.user_id" />
                                <span id="signature" />
                            </td>
                            <td>
                                <div>
                                    <span>Delegate:</span>
                                    <span t-field="o.delegate_id" />
                                </div>
                                <div>
                                    <span>Mean Transport:</span>
                                    <span t-field="o.mean_transp" />
                                </div>
                                <div>
                                    <span>Signature for receive</span>
                                </div>
                            </td>
                        </tr>
                        <tr />  <!-- empty row for white color-->
                    </table>
                </div>
                <div class="col-5">
                    <!-- Tax totals summary (invoice currency) -->


                    <table class="o_total_table table table-borderless mb-0" style="page-break-inside: avoid;">
                        <t t-if="o.tax_totals" t-call="account.document_tax_totals">
                            <t t-set="tax_totals" t-value="o.tax_totals" />
                            <t t-set="currency" t-value="o.currency_id" />
                        </t>
                    </table>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@name='comment']" position="before">
            <div class="text-muted mb-3">
                <span t-if="o.move_type == 'out_invoice' or o.move_type == 'out_refund'" name="legal_text">
                        Invoice valid without signature and stamp according to art.V, paragraph (2) of Ordinance
                        no.17 / 2015, art. 319 paragraph (29) of Law no. 227/2015 on the Fiscal Code and
                        subsequent amendments.

                </span>
            </div>
            <div t-if="o.commercial_partner_id.info_for_invoice" name="info_text">
                <span t-field="o.commercial_partner_id.info_for_invoice" />
            </div>

        </xpath>

        <xpath expr="//p[@name='payment_communication']" position="attributes">
            <attribute name="t-if">not res_company.hide_invoice_payment_communication</attribute>
        </xpath>

        <xpath expr="//div[hasclass('page')]" position="after">
            <t t-if="print_with_payments">
                <t
                    t-set="payments_vals"
                    t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"
                />
                <t t-set="payments_vals_cash" t-value="[]" />
                <t t-foreach="payments_vals" t-as="payment_vals">
                    <t t-if="payment_vals['journal_type']=='cash'">
                        <t t-set="payments_vals_cash" t-value="payments_vals_cash + [payment_vals]" />
                    </t>
                </t>
                <t t-if="payments_vals_cash">
                    <br />
                    <div
                        t-foreach="payments_vals_cash"
                        t-as="payment_vals"
                        style="page-break-inside: avoid; border: 1px solid black;padding: 15px;"
                    >


                        <t name="payment_container">
                            <t t-set="res_company" t-value="o.company_id" />
                            <div>
                                <strong t-field="res_company.partner_id.name" />
                            </div>
                            <div>
                                VAT:
                                <span t-field="res_company.partner_id.vat" />
                            </div>
                            <div>
                                NRC:
                                <span t-field="res_company.partner_id.nrc" />
                            </div>
                            <address
                                t-field="res_company.partner_id"
                                t-options='{"widget": "contact", "fields": ["address"], "no_marker": true, "no_tag_br": true}'
                            />
                            <h4>
                                <t t-if="payment_vals['payment_type']=='inbound'">
                                    <span>Voucher:</span>
                                </t>
                                <t t-if="payment_vals['payment_type']=='outbound'">
                                    <span>Payment disposal:</span>
                                </t>

                                <span t-esc="payment_vals['ref']" />
                                <span>/</span>
                                <t t-esc="payment_vals['date']" t-options='{"widget": "date"}' />
                            </h4>
                            <div name="payment_text">
                                <t t-if="payment_vals['payment_type']=='outbound'">
                                    <span>I payed to</span>
                                </t>
                                <t t-else="">
                                    <span>I received from</span>
                                </t>
                                <t t-set="partner" t-value="o.partner_id.commercial_partner_id" />
                                <strong t-field="partner.name" />

                                <span t-if="partner.vat">
                                    ,<span t-field="partner.vat" />,
                                </span>
                                <span t-if="partner.nrc">
                                    <span t-field="partner.nrc" />,
                                </span>

                                <span t-if="partner.city" name="address">
                                    from
                                    <span t-field="partner.city" />
                                    <span t-field="partner.street" />
                                    <span t-field="partner.street2" />
                                </span>

                                <span>amount</span>

                                <strong
                                    t-esc="payment_vals['amount']"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                />
                                (
                                <!--                                <span t-esc="convert(payment.amount)"/>-->
                                <span t-esc="o.currency_id.amount_to_text(payment_vals['amount'])" />
                                )
                            </div>
                            <div>
                                Representing counter value of invoice
                                <span t-field="o.name" />
                            </div>

                        </t>
                    </div>
                </t>
            </t>
        </xpath>
    </template>

    <template id="document_tax_totals_template" inherit_id="account.document_tax_totals_template" priority="100">
        <xpath expr="//tr[hasclass('o_subtotal')]/td[2]/span" position="before">
            <t t-if="o and o._name == 'account.move' and o.move_type in ['out_refund', 'in_refund']">
                <span>-</span>
            </t>
        </xpath>
        <xpath expr="//tr[hasclass('o_taxes')]/t/td[2]/span" position="before">
            <t t-if="o and o._name == 'account.move' and o.move_type in ['out_refund', 'in_refund']">
                <span>-</span>
            </t>
        </xpath>
        <xpath expr="//tr[hasclass('o_taxes')]/t[2]/td[2]/span" position="before">
            <t t-if="o and o._name == 'account.move' and o.move_type in ['out_refund', 'in_refund']">
                <span>-</span>
            </t>
        </xpath>
        <xpath expr="//tr[hasclass('o_total')]/td[2]/strong" position="before">
            <t t-if="o and o._name == 'account.move' and o.move_type in ['out_refund', 'in_refund']">
                <strong>-</strong>
            </t>
        </xpath>
    </template>

</odoo>
