<?xml version="1.0" ?>
<odoo>
    <!--
        Chitanța tipărită din plată folosește aceeași cutie ca cea adăugată la
        finalul facturii (`report_cash_receipt`) - este același document legal,
        deci trebuie să arate la fel indiferent de unde e tipărit.
    -->
    <template id="report_payment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t
                            t-call="l10n_ro_invoice_report.report_cash_receipt"
                            res_company="o.company_id"
                            partner="o.partner_id.commercial_partner_id"
                            payment_type="o.payment_type"
                            receipt_ref="o.name"
                            receipt_date="o.date"
                            amount="o.amount"
                            currency="o.currency_id"
                            documents="o.reconciled_invoice_ids | o.reconciled_bill_ids"
                            representing="o.memo"
                        />
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
