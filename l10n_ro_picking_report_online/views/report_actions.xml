<?xml version="1.0" ?>
<odoo>

        <record id="action_report_delivery" model="ir.actions.report">
            <field name="name">Delivery</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_ro_picking_report_online.report_delivery</field>
            <field name="print_report_name">'%s %s' % (object.picking_type_id.name, object.name)</field>
            <field name="binding_model_id" ref="stock.model_stock_picking" />
            <field name="binding_type">report</field>
        </record>
