<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The invoice lines, as a table. -->
    <template id="spv_invoice_lines">
        <div class="table-responsive">
            <table class="table table-sm o_spv_lines">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Code</th>
                        <th>Description</th>
                        <th>UoM</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit price</th>
                        <th class="text-end">VAT %</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="lines" t-as="line">
                        <td t-out="line['number']" />
                        <td t-out="line['code']" />
                        <td t-out="line['name']" />
                        <td t-out="line['unit']" />
                        <td class="text-end" t-out="line['quantity']" />
                        <td class="text-end" t-out="line['price']" />
                        <td class="text-end" t-out="line['tax_percent']" />
                        <td class="text-end" t-out="line['amount']" />
                    </tr>
                </tbody>
            </table>
            <p t-if="not lines" class="text-muted">The XML has no invoice lines.</p>
        </div>
    </template>

    <!-- A view of the document, built from the XML of the invoice. -->
    <template id="spv_invoice_document">
        <div class="o_spv_document">
            <!-- The other party first, the invoice in the middle and our own company last:
                 on a received invoice we are the customer, on an issued one the supplier. -->
            <t t-set="other_party" t-value="supplier if incoming else customer" />
            <t t-set="own_party" t-value="customer if incoming else supplier" />
            <div class="o_spv_boxes mb-3">
                <div class="o_spv_box">
                    <div class="text-muted text-uppercase small">
                        <t t-if="incoming">Supplier</t>
                        <t t-else="">Customer</t>
                    </div>
                    <div class="fw-bold" t-out="other_party.get('name')" />
                    <div t-if="other_party.get('vat')">VAT ID <t t-out="other_party.get('vat')" /></div>
                    <div t-if="other_party.get('address')" t-out="other_party.get('address')" />
                </div>
                <div class="o_spv_box">
                    <div class="text-muted text-uppercase small">
                        <t t-if="is_credit_note">Credit note</t>
                        <t t-else="">Invoice</t>
                    </div>
                    <div class="fw-bold">No. <t t-out="number" /></div>
                    <div t-if="issue_date">Date: <t t-out="issue_date" /></div>
                    <div t-if="due_date">Due date: <t t-out="due_date" /></div>
                    <div t-if="currency">Currency: <t t-out="currency" /></div>
                </div>
                <div class="o_spv_box o_spv_box_own">
                    <div class="text-muted text-uppercase small">
                        <t t-if="incoming">Customer</t>
                        <t t-else="">Supplier</t>
                    </div>
                    <div class="fw-bold" t-out="own_party.get('name')" />
                    <div t-if="own_party.get('vat')">VAT ID <t t-out="own_party.get('vat')" /></div>
                    <div t-if="own_party.get('address')" t-out="own_party.get('address')" />
                </div>
            </div>
            <t t-call="l10n_ro_message_spv_side_panel.spv_invoice_lines" />
            <div class="d-flex justify-content-end">
                <table class="table table-sm w-auto">
                    <tr>
                        <td>Total without VAT</td>
                        <td class="text-end" t-out="untaxed" />
                    </tr>
                    <tr>
                        <td>VAT</td>
                        <td class="text-end" t-out="tax" />
                    </tr>
                    <tr class="fw-bold">
                        <td>Total</td>
                        <td class="text-end"><t t-out="total" /> <t t-out="currency" /></td>
                    </tr>
                </table>
            </div>
            <p t-if="note" class="text-muted small" t-out="note" />
            <p class="text-muted small mb-0">Representation generated from the e-Factura XML downloaded from SPV.</p>
        </div>
    </template>
</odoo>
