<?xml version="1.0" ?>
<odoo>
    <record id="res_config_settings_view_form_reception_taxes" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.ro.picking.report</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='operations_setting_container']" position="after">
                <block title="Romanian Stock Documents" name="l10n_ro_picking_report_setting_container">
                    <setting
                        id="l10n_ro_picking_report_taxes_on_reception"
                        company_dependent="1"
                        help="Show taxes values on reception report"
                    >
                        <field name="taxes_on_reception" />
                    </setting>
                    <setting
                        id="l10n_ro_picking_report_banks_on_pickings"
                        company_dependent="1"
                        help="Show banks on picking report"
                    >
                        <field name="banks_on_pickings" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
