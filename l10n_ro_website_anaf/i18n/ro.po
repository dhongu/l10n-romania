#. module: l10n_ro_website_anaf
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf/static/src/interactions/anaf_lookup.esm.js:0
msgid "%s is struck off at ANAF: it cannot place an order."
msgstr "%s este radiată la ANAF: nu poate plasa o comandă."

#. module: l10n_ro_website_anaf
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf/static/src/interactions/anaf_lookup.esm.js:0
msgid "Fill in from ANAF"
msgstr "Completează din ANAF"

#. module: l10n_ro_website_anaf
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf/static/src/interactions/anaf_lookup.esm.js:0
msgid "The invoice is issued to %s"
msgstr "Factura se emite pe %s"

#. module: l10n_ro_website_anaf
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf/static/src/interactions/anaf_lookup.esm.js:0
msgid ""
"This company is fiscally inactive at ANAF. The order can be placed, but "
"while it is inactive the company cannot deduct the expense and the VAT of "
"the purchase."
msgstr ""
"Această firmă figurează ca inactivă fiscal la ANAF. Comanda poate fi "
"plasată, însă cât timp firma este inactivă nu își poate deduce cheltuiala și"
" TVA-ul aferente achiziției."

#. module: l10n_ro_website_anaf
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf/static/src/interactions/anaf_lookup.esm.js:0
msgid ""
"This looks like a personal numeric code (CNP). If you buy as an individual, "
"leave the field empty."
msgstr ""
"Acesta pare a fi un cod numeric personal (CNP). Dacă cumpărați ca persoană "
"fizică, lăsați câmpul gol."

#. module: l10n_ro_website_anaf
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf/static/src/interactions/anaf_lookup.esm.js:0
msgid "This tax code does not appear at ANAF."
msgstr "Acest cod fiscal nu apare la ANAF."

#. module: l10n_ro_website_anaf
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf/static/src/interactions/anaf_lookup.esm.js:0
msgid "VAT payer"
msgstr "plătitor de TVA"

#. module: l10n_ro_website_anaf
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf/static/src/interactions/anaf_lookup.esm.js:0
msgid "not a VAT payer"
msgstr "neplătitor de TVA"

#. module: l10n_ro_website_anaf
#. odoo-javascript
#: code:addons/l10n_ro_website_anaf/static/src/interactions/anaf_lookup.esm.js:0
msgid "Looking up at ANAF…"
msgstr "Se caută la ANAF…"

#. module: l10n_ro_website_anaf
#. odoo-python
#: code:addons/l10n_ro_website_anaf/controllers/website_sale.py:0
msgid ""
"Customer %(vat)s is declared fiscally inactive at ANAF (since %(date)s), its"
" VAT code is cancelled: invoice with VAT, without reverse charge, tax code "
"without the RO prefix. Check the collection, preferably payment in advance."
msgstr ""
"Clientul %(vat)s este declarat inactiv fiscal la ANAF (din %(date)s), iar "
"codul său de TVA este anulat: facturăm cu TVA, fără taxare inversă, cu codul"
" fiscal fără prefixul RO. Verificați încasarea, de preferat cu plată în "
"avans."

#. module: l10n_ro_website_anaf
#. odoo-python
#: code:addons/l10n_ro_website_anaf/controllers/website_sale.py:0
msgid ""
"The VAT number %(vat)s could not be checked at ANAF (service unavailable). "
"Please check the customer details."
msgstr ""
"Codul fiscal %(vat)s nu a putut fi verificat la ANAF (serviciu "
"indisponibil). Verificați datele clientului."

#. module: l10n_ro_website_anaf
#. odoo-python
#: code:addons/l10n_ro_website_anaf/controllers/website_sale.py:0
msgid "The VAT number is not valid according to ANAF"
msgstr "Codul fiscal nu este valid conform ANAF"

#. module: l10n_ro_website_anaf
#. odoo-python
#: code:addons/l10n_ro_website_anaf/controllers/website_sale.py:0
msgid "The VAT number must contain only digits (after the country code)"
msgstr "Codul fiscal trebuie să conțină doar cifre (după codul țării)"

#. module: l10n_ro_website_anaf
#. odoo-python
#: code:addons/l10n_ro_website_anaf/controllers/website_sale.py:0
msgid "The company with this tax code is struck off at ANAF."
msgstr "Firma cu acest cod fiscal este radiată la ANAF."

#. module: l10n_ro_website_anaf
#. odoo-python
#: code:addons/l10n_ro_website_anaf/controllers/website_sale.py:0
msgid ""
"This looks like a personal numeric code (CNP). This field is for the tax "
"code (CUI) of a company; if you buy as an individual, leave it empty."
msgstr ""
"Acesta pare a fi un cod numeric personal (CNP). Câmpul este pentru codul "
"fiscal (CUI) al unei firme; dacă cumpărați ca persoană fizică, lăsați-l gol."
