<odoo>
    <record id="view_hr_employee_revisal_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.revisal.wizard.form</field>
        <field name="model">hr.employee.revisal.wizard</field>
        <field name="arch" type="xml">
            <form string="HR Employee Revisal Wizard">
                <group>
                    <field name="file" widget="binary" filename="file_name" />
                    <field name="filename" invisible="1" />
                </group>
                <footer>
                    <button string="Import" type="object" name="action_import" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_revisal_wizard" model="ir.actions.act_window">
        <field name="name">HR Employee Revisal Wizard</field>
        <field name="res_model">hr.employee.revisal.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

        <menuitem
        id="menu_hr_employee_revisal"
        name="Import Revisal"
        action="action_hr_employee_revisal_wizard"
        parent="hr.menu_hr_employee_payroll"
        sequence="100"
    />


</odoo>
