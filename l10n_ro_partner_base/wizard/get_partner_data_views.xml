<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ro_get_partner_data_form" model="ir.ui.view">
        <field name="name">l10n.ro.get.partner.data.form</field>
        <field name="model">l10n.ro.get.partner.data</field>
        <field name="arch" type="xml">
            <form string="Get Partner Data">
                <field name="state" invisible="1" />
                <group invisible="state != 'get'">
                    <field name="partner_id" />
                    <field name="service" widget="radio" />
                </group>
                <field name="status_message" readonly="1" invisible="state != 'set'" />
                <footer invisible="state != 'get'">
                    <button
                        name="do_get_data"
                        string="Get Data"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Close" class="oe_link" special="cancel" />
                </footer>
                <footer invisible="state != 'set'">
                    <button name="do_back" string="Back" type="object" />
                    <button string="Close" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="l10n_ro_get_partner_data_action" model="ir.actions.act_window">
        <field name="name">Get Partner's Data</field>
        <field name="res_model">l10n.ro.get.partner.data</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
