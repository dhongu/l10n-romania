<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_l10n_ro_partner_base" model="ir.ui.view">
        <field name="name">res.company.form.l10n_ro_partner_base</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <field name="company_registry" position="after">
                <field name="l10n_ro_caen_code" invisible="country_code != 'RO'" />
            </field>
        </field>
    </record>
</odoo>
