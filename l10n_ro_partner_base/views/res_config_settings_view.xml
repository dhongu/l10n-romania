<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_l10n_ro_partner_base" model="ir.ui.view">
        <field name="name">res.config.settings.form.l10n_ro_partner_base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="contacts_setting_container" position="inside">
                <setting
                    id="l10n_ro_partner_unique_setting"
                    string="Unique Partners (Romania)"
                    help="Do not allow two company partners with the same VAT (or VAT and NRC)"
                >
                    <field name="l10n_ro_vat_nrc_unique" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
