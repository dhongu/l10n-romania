<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_l10n_ro_partner_base" model="ir.ui.view">
        <field name="name">res.partner.form.l10n_ro_partner_base</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="nrc" position="after">
                <label for="l10n_ro_vat_subjected" invisible="not is_company" />
                <div class="o_row" invisible="not is_company">
                    <field name="l10n_ro_vat_subjected" />
                </div>
                <field name="l10n_ro_vat_number" invisible="1" />
            </field>
            <xpath
                expr="//div[hasclass('alert', 'alert-warning', 'oe_edit_only')]"
                position="before"
            >
                <header>
                    <button
                        name="%(l10n_ro_get_partner_data_action)d"
                        invisible="(not name and not vat) or not is_company"
                        string="Get Data"
                        type="action"
                    />
                </header>
                <field name="l10n_ro_partner_warning" invisible="1" />
                <div
                    class="alert alert-danger"
                    role="alert"
                    style="margin-bottom:0px;"
                    invisible="not l10n_ro_partner_warning"
                >
                    <span>
                        <field name="l10n_ro_partner_warning" />
                    </span>
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_res_partner_filter_l10n_ro_partner_base" model="ir.ui.view">
        <field name="name">res.partner.select.l10n_ro_partner_base</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="vat" />
            </field>
        </field>
    </record>
</odoo>
