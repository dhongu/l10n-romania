<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extindere form: câmpuri DVI pe landed cost -->
    <record id="view_stock_landed_cost_form" model="ir.ui.view">
        <field name="name">stock.landed.cost.form</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">
            <notebook position="before">
                <group>
                    <group>
                        <field name="landed_type"/>
                        <field name="dvi_number" invisible="landed_type == 'standard'"/>
                        <field name="customs_regime" invisible="landed_type == 'standard'"/>
                        <field name="customs_office_id" invisible="landed_type == 'standard'"
                               context="{'default_is_company': True}"/>
                    </group>
                    <group invisible="landed_type == 'standard'">
                        <field name="tax_id"/>
                        <field name="tax_base"/>
                        <field name="tax_value" invisible="customs_regime == '4200'"/>
                        <field name="vat_guarantee_amount" invisible="customs_regime != '4200'"/>
                        <label for="vat_guarantee_state" invisible="customs_regime != '4200'"/>
                        <div class="o_row" invisible="customs_regime != '4200'">
                            <field name="vat_guarantee_state"/>
                            <button name="action_release_vat_guarantee" type="object" string="Mark as Released"
                                    class="btn-link" icon="fa-unlock"
                                    invisible="vat_guarantee_state != 'blocked'"/>
                        </div>
                    </group>
                </group>
            </notebook>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="Paid" invisible="customs_payment_state != 'paid'"/>
                <widget name="web_ribbon" title="Partially Paid" bg_color="text-bg-warning"
                        invisible="customs_payment_state != 'partial'"/>
            </xpath>
            <!-- Un articol din DVI pe linie: codul TARIC și produsele pe care se repartizează taxa lui -->
            <xpath expr="//field[@name='cost_lines']/list/field[@name='name']" position="after">
                <field name="l10n_ro_dvi_taric_code" optional="show" column_invisible="parent.landed_type != 'dvi'"/>
                <field name="l10n_ro_dvi_product_ids" widget="many2many_tags" optional="show"
                       column_invisible="parent.landed_type != 'dvi'"/>
            </xpath>
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="customs_amount_due" invisible="landed_type != 'dvi' or not customs_payment_state"/>
            </xpath>
        </field>
    </record>

    <!-- Extindere search view: filtru rapid DVI -->
    <record id="view_stock_landed_cost_search_dvi" model="ir.ui.view">
        <field name="name">stock.landed.cost.search.dvi</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_search"/>
        <field name="arch" type="xml">
            <field name="picking_ids" position="after">
                <field name="dvi_number"/>
                <field name="customs_office_id"/>
            </field>
            <filter name="done" position="after">
                <separator/>
                <filter name="filter_dvi"
                        string="DVI"
                        domain="[('landed_type', '=', 'dvi')]"/>
                <filter name="filter_vat_guarantee_blocked"
                        string="VAT Guarantee Blocked"
                        domain="[('vat_guarantee_state', '=', 'blocked')]"/>
                <filter name="filter_customs_not_paid"
                        string="Due at Customs"
                        domain="[('customs_payment_state', 'in', ('not_paid', 'partial'))]"/>
            </filter>
            <filter name="group_by_month" position="after">
                <filter string="Customs Office" name="group_by_customs_office" context="{'group_by': 'customs_office_id'}"/>
                <filter string="Customs Payment" name="group_by_customs_payment_state"
                        context="{'group_by': 'customs_payment_state'}"/>
            </filter>
        </field>
    </record>

    <!-- Extindere listă: nr. DVI ca coloană opțională -->
    <record id="view_stock_landed_cost_tree_dvi" model="ir.ui.view">
        <field name="name">stock.landed.cost.list.dvi</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="dvi_number" optional="show"/>
                <field name="customs_office_id" optional="hide"/>
            </field>
            <!-- Suma repartizată, ca lista lunară să poată fi confruntată cu evidența vamală -->
            <field name="date" position="after">
                <field name="amount_total" optional="show" sum="Total"/>
                <field name="vat_guarantee_amount" optional="hide" sum="Total"/>
                <field name="vat_guarantee_state" optional="hide"/>
                <field name="customs_amount_due" optional="show" sum="Total"/>
                <field name="customs_payment_state" widget="badge" optional="show"
                       decoration-danger="customs_payment_state == 'not_paid'"
                       decoration-warning="customs_payment_state == 'partial'"
                       decoration-success="customs_payment_state == 'paid'"/>
            </field>
        </field>
    </record>

    <!-- Acțiune dedicată: lista DVI-uri -->
    <record id="action_stock_landed_cost_dvi" model="ir.actions.act_window">
        <field name="name">DVI — Costuri vamale</field>
        <field name="res_model">stock.landed.cost</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('landed_type', '=', 'dvi')]</field>
        <field name="context">{'search_default_filter_dvi': 1, 'search_default_group_by_month': 1}</field>
    </record>

    <!-- Meniu -->
    <menuitem id="menu_stock_landed_cost_dvi"
              name="DVI — Costuri vamale"
              parent="account.menu_finance_entries"
              action="action_stock_landed_cost_dvi"
              sequence="50"/>

</odoo>
