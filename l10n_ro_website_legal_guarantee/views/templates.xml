<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Notificarea armonizată UE, întreagă și nemodificată (ghidul DG JUST, cap. 2.3) -->
    <template id="legal_guarantee_notice" name="EU legal guarantee notice">
        <t t-set="notice" t-value="website._get_legal_guarantee_notice()" />
        <figure class="o_legal_guarantee_notice mb-0">
            <a t-att-href="notice['pdf_url']" target="_blank" rel="noopener">
                <img
                    t-att-src="notice['image_url']"
                    class="img-fluid w-100"
                    width="1654"
                    height="2339"
                    loading="lazy"
                    alt="Harmonised notice of the European Union on the legal guarantee of conformity"
                />
            </a>
            <figcaption class="small mt-2">
                More information:
                <a t-att-href="notice['link_url']" target="_blank" rel="noopener" t-out="notice['link_text']" />
                &#183;
                <a t-att-href="notice['pdf_url']" target="_blank" rel="noopener">Download the notice (PDF)</a>
            </figcaption>
        </figure>
    </template>

    <!-- Link care deschide notificarea la primul clic (pagina de produs, finalizarea comenzii) -->
    <template id="legal_guarantee_link" name="EU legal guarantee link">
        <div class="o_legal_guarantee mb-3">
            <a
                href="/garantie"
                class="o_legal_guarantee_link"
                data-bs-toggle="modal"
                data-bs-target="#o_legal_guarantee_modal"
                aria-haspopup="dialog"
            >Your legal guarantee rights</a>
        </div>
    </template>

    <!-- Fereastra cu notificarea, la nivelul body (în coloana sticky a produsului ar rămâne sub alte elemente) -->
    <template id="legal_guarantee_modal" inherit_id="web.frontend_layout" priority="510">
        <xpath expr="//div[@id='wrapwrap']" position="after">
            <t
                t-if="website and (website.legal_guarantee_product or website.legal_guarantee_checkout)"
            >
                <div
                    id="o_legal_guarantee_modal"
                    class="modal fade"
                    tabindex="-1"
                    aria-labelledby="o_legal_guarantee_modal_title"
                    aria-hidden="true"
                >
                    <div class="modal-dialog modal-lg modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 id="o_legal_guarantee_modal_title" class="modal-title">Legal guarantee of conformity</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
                            </div>
                            <div class="modal-body">
                                <t t-call="l10n_ro_website_legal_guarantee.legal_guarantee_notice" />
                            </div>
                            <div class="modal-footer">
                                <a href="/garantie" class="btn btn-link">Your rights and how to report a problem</a>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="legal_guarantee_page" name="Legal guarantee of conformity">
        <t t-call="website.layout">
            <t t-set="additional_title">Legal guarantee of conformity</t>
            <t t-set="company" t-value="website.company_id" />
            <div id="wrap" class="o_legal_guarantee_page">
                <div class="oe_structure" id="oe_structure_legal_guarantee_1" />
                <div class="container py-4">
                    <h1>Legal guarantee of conformity</h1>
                    <p class="lead">
                        For goods bought by consumers, the seller is liable for any lack of conformity
                        which exists at the time of delivery and becomes apparent within two years.
                        Below you can find the official notice of the European Union, a short summary
                        of your rights and how to report a problem.
                    </p>
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <h2 class="h4">EU notice on the legal guarantee</h2>
                            <p class="small text-muted">
                                Harmonised notice of the European Commission (Commission Implementing
                                Regulation (EU) 2025/1960, Annex I).
                            </p>
                            <t t-call="l10n_ro_website_legal_guarantee.legal_guarantee_notice" />
                        </div>
                        <div class="col-lg-5">
                            <h2 class="h4">Your rights in short</h2>
                            <p>
                                Under Government Emergency Ordinance no. 140/2021 on certain aspects of
                                contracts for the sale of goods:
                            </p>
                            <ul>
                                <li>
                                    The seller is liable for any lack of conformity which exists at
                                    delivery and becomes apparent within two years of delivery.
                                </li>
                                <li>
                                    A lack of conformity which becomes apparent within one year of
                                    delivery is presumed to have existed at delivery, unless proven
                                    otherwise.
                                </li>
                                <li>
                                    You may choose between repair and replacement, free of charge, within
                                    a reasonable period agreed in writing, of no more than 15 calendar
                                    days from the date you informed the seller.
                                </li>
                                <li>
                                    In some cases you may ask for a price reduction or terminate the
                                    contract, for example when repair or replacement was refused or not
                                    carried out.
                                </li>
                                <li>
                                    These rights cannot be excluded or limited by contract to your
                                    detriment.
                                </li>
                            </ul>
                            <h2 class="h4">How to report a problem</h2>
                            <ul>
                                <li class="o_translate_inline">
                                    Contact us as soon as possible after you notice the problem, by phone,
                                    e-mail or through the <a href="/contactus">contact form</a>.
                                </li>
                                <li>
                                    Provide proof of purchase, such as the invoice, the receipt, the bank
                                    statement or the order number.
                                </li>
                                <li class="o_translate_inline">
                                    If we cannot reach an agreement, you can contact the National Authority
                                    for Consumer Protection (<a href="https://anpc.ro" target="_blank" rel="noopener">ANPC</a>)
                                    or an
                                    <a href="https://reclamatiisal.anpc.ro/" target="_blank" rel="noopener">alternative dispute resolution entity</a>.
                                </li>
                            </ul>
                            <h2 class="h4">Commercial guarantees</h2>
                            <p class="o_translate_inline">
                                Sellers and producers may also offer commercial guarantees. These apply in
                                addition to the legal guarantee and do not replace it. The EU GARAN label
                                marks a commercial guarantee of durability offered by the producer at no
                                extra cost, covering the whole good, for more than two years.
                                <a
                                    href="https://europa.eu/youreurope/commercial-guarantee-durability/index.htm"
                                    target="_blank"
                                    rel="noopener"
                                >More about the GARAN label</a>.
                            </p>
                            <h2 class="h4">The seller</h2>
                            <div class="o_legal_guarantee_seller mb-3">
                                <div><strong t-out="company.name" /></div>
                                <div t-if="company.vat"><span>Tax ID:</span> <t t-out="company.vat" /></div>
                                <div
                                    t-if="company.partner_id.contact_address.strip()"
                                    style="white-space: pre-line"
                                    t-out="company.partner_id.contact_address.strip()"
                                />
                                <div t-if="company.phone">
                                    <span>Phone:</span>
                                    <a t-att-href="'tel:%s' % company.phone" t-out="company.phone" />
                                </div>
                                <div t-if="company.email">
                                    <span>E-mail:</span>
                                    <a t-att-href="'mailto:%s' % company.email" t-out="company.email" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="oe_structure" id="oe_structure_legal_guarantee_2" />
            </div>
        </t>
    </template>

    <template id="legal_guarantee_footer" inherit_id="web.frontend_layout" priority="510">
        <xpath expr="//div[hasclass('o_footer_copyright')]/div/div" position="inside">
            <div t-if="website and website.legal_guarantee_footer" class="o_footer_legal_guarantee col-md-auto text-center">
                <a href="/garantie">Legal guarantee</a>
            </div>
        </xpath>
    </template>

    <template id="legal_guarantee_product" inherit_id="website_sale.product">
        <xpath expr="//div[@id='o_wsale_product_details_content']" position="inside">
            <t t-if="website.legal_guarantee_product" t-call="l10n_ro_website_legal_guarantee.legal_guarantee_link" />
        </xpath>
    </template>

    <template id="legal_guarantee_payment" inherit_id="website_sale.payment">
        <xpath expr="//div[@id='address_on_payment']" position="after">
            <t t-if="website.legal_guarantee_checkout" t-call="l10n_ro_website_legal_guarantee.legal_guarantee_link" />
        </xpath>
    </template>

</odoo>
