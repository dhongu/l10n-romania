#. module: l10n_ro_customs_dvi_import
#. odoo-python
#: code:addons/l10n_ro_customs_dvi_import/wizard/account_dvi.py:0
msgid ""
"Check the tax: VAT paid at customs, or deferred (VAT deferral certificate). "
"The declaration does not tell them apart."
msgstr ""
"Verificați taxa: TVA plătit în vamă sau amânat (certificat de amânare). "
"Declarația nu le deosebește."

#. module: l10n_ro_customs_dvi_import
#. odoo-python
