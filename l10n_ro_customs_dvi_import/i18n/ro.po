"The declaration has %(count)s articles, but %(read)s were read from the "
"document."
msgstr ""
"Declarația are %(count)s articole, dar din document s-au citit %(read)s."

#. module: l10n_ro_customs_dvi_import
#. odoo-python
#: code:addons/l10n_ro_customs_dvi_import/wizard/account_dvi.py:0
