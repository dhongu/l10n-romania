<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_ro_edi_document_list" model="ir.ui.view">
        <field name="name">l10n_ro_edi.document.list.spv.online</field>
        <field name="model">l10n_ro_edi.document</field>
        <field name="arch" type="xml">
            <list
                string="SPV Messages"
                create="false"
                edit="false"
                delete="false"
                decoration-danger="state == 'invoice_refused'"
                decoration-warning="state == 'invoice_sent'"
                decoration-success="state == 'invoice_validated'"
            >
                <header>
                    <button
                        name="%(action_spv_synchronize)d"
                        type="action"
                        string="Synchronize now"
                        class="btn-primary"
                        display="always"
                    />
                </header>
                <field name="datetime" />
                <field name="x_received" string="Received" widget="boolean" optional="show" />
                <field name="invoice_id" />
                <field name="x_partner_id" />
                <field name="x_invoice_date" optional="show" />
                <field name="x_currency_id" column_invisible="1" />
                <field name="x_amount_total" optional="show" />
                <field name="state" widget="badge"
                    decoration-danger="state == 'invoice_refused'"
                    decoration-warning="state == 'invoice_sent'"
                    decoration-success="state == 'invoice_validated'"
                />
                <field name="message" optional="show" />
                <field name="key_download" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_l10n_ro_edi_document_form" model="ir.ui.view">
        <field name="name">l10n_ro_edi.document.form.spv.online</field>
        <field name="model">l10n_ro_edi.document</field>
        <field name="arch" type="xml">
            <form string="SPV Message" create="false" edit="false" delete="false">
                <header>
                    <button
                        name="action_l10n_ro_edi_fetch_status"
                        type="object"
                        string="Fetch status"
                        class="btn-primary"
                        invisible="not show_fetch_status_button"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="invoice_id" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="x_received" />
                            <field name="x_partner_id" />
                            <field name="x_invoice_date" />
                            <field name="x_currency_id" invisible="1" />
                            <field name="x_amount_total" />
                        </group>
                        <group>
                            <field name="datetime" />
                            <field name="key_download" />
                            <field name="key_signature" groups="base.group_no_one" />
                            <field name="key_certificate" groups="base.group_no_one" />
                            <field name="show_fetch_status_button" invisible="1" />
                        </group>
                    </group>
                    <group string="Message" invisible="not message">
                        <field name="message" nolabel="1" colspan="2" />
                    </group>
                    <group string="Files">
                        <field
                            name="attachment"
                            string="XML of the message"
                            filename="x_attachment_name"
                            widget="binary"
                        />
                        <field name="x_attachment_name" invisible="1" />
                        <field
                            name="x_invoice_attachment_ids"
                            string="Invoice files (XML, PDF)"
                            widget="many2many_binary"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ro_edi_document_search" model="ir.ui.view">
        <field name="name">l10n_ro_edi.document.search.spv.online</field>
        <field name="model">l10n_ro_edi.document</field>
        <field name="arch" type="xml">
            <search string="SPV Messages">
                <field name="invoice_id" />
                <field name="x_partner_id" />
                <field name="key_download" />
                <field name="message" />
                <filter name="sent" string="Sent" domain="[('x_received', '=', False)]" />
                <filter name="received" string="Received" domain="[('x_received', '=', True)]" />
                <separator />
                <filter name="waiting" string="Waiting for ANAF" domain="[('state', '=', 'invoice_sent')]" />
                <filter name="validated" string="Validated" domain="[('state', '=', 'invoice_validated')]" />
                <filter name="refused" string="Refused" domain="[('state', '=', 'invoice_refused')]" />
                <filter
                    name="errors"
                    string="Errors"
                    domain="[('message', '!=', False)]"
                />
                <separator />
                <filter name="filter_datetime" string="Date" date="datetime" />
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                    <filter name="group_received" string="Direction" context="{'group_by': 'x_received'}" />
                    <filter name="group_partner" string="Partner" context="{'group_by': 'x_partner_id'}" />
                    <filter name="group_datetime" string="Date" context="{'group_by': 'datetime:month'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_spv_messages" model="ir.actions.act_window">
        <field name="name">SPV Messages</field>
        <field name="res_model">l10n_ro_edi.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_ro_edi_document_search" />
        <field name="context">{'search_default_group_state': 1}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_l10n_ro_edi_document_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_l10n_ro_edi_document_form')})]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No SPV message yet</p>
            <p>
                The invoices sent to e-Factura and the bills received from the SPV show up here.
                Click <b>Synchronize now</b> to fetch the latest messages from ANAF.
            </p>
        </field>
    </record>
</odoo>
