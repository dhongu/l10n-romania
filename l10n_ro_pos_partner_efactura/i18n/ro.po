msgid "ANAF has no company registered under the CUI %(cui)s."
msgstr "La ANAF nu există nicio firmă înregistrată cu CUI-ul %(cui)s."

#. module: l10n_ro_pos_partner_efactura
#. odoo-python
#: code:addons/l10n_ro_pos_partner_efactura/models/res_partner.py:0
msgid "ANAF lists the company %(name)s (CUI %(cui)s) as struck off."
msgstr "ANAF arată firma %(name)s (CUI %(cui)s) ca radiată."

#. module: l10n_ro_pos_partner_efactura
