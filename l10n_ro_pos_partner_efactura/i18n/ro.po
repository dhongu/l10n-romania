#. module: l10n_ro_pos_partner_efactura
#: model_terms:ir.ui.view,arch_db:l10n_ro_pos_partner_efactura.view_partner_form_pos_efactura_anaf
msgid ""
"<strong>Data fetched from ANAF.</strong>\n"
"                    Check it against the customer's documents and save: the ANAF data is often\n"
"                    incomplete or outdated, and e-Factura (SPV) refuses an invoice with a wrong address."
msgstr ""
"<strong>Date preluate din ANAF.</strong>\n"
"                    Verifică-le cu documentele clientului și salvează: datele ANAF sunt adesea\n"
"                    incomplete sau neactualizate, iar e-Factura (SPV) respinge factura cu adresă greșită."

#. module: l10n_ro_pos_partner_efactura
