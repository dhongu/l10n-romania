#. module: l10n_ro_pos_partner_efactura
#: model:ir.model.fields,help:l10n_ro_pos_partner_efactura.field_res_partner__l10n_ro_pos_anaf_to_confirm
#: model:ir.model.fields,help:l10n_ro_pos_partner_efactura.field_res_users__l10n_ro_pos_anaf_to_confirm
msgid ""
"The customer was fetched from ANAF in the Point of Sale and the cashier has "
"not confirmed its data yet."
msgstr ""
"Clientul a fost preluat din ANAF în Punctul de vânzare, iar casierul nu i-a "
"confirmat încă datele."

#. module: l10n_ro_pos_partner_efactura
#. odoo-python
#: code:addons/l10n_ro_pos_partner_efactura/models/res_partner.py:0
msgid ""
"The partner %(partner)s cannot receive an e-Factura invoice:\n"
"- %(missing)s\n"
"If the data could not be fetched from ANAF, fill it in manually."
msgstr ""
"Partenerul %(partner)s nu poate primi o factură e-Factura:\n"
"- %(missing)s\n"
"Dacă datele nu au putut fi preluate de la ANAF, completați-le manual."

