<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Required only in the partner form opened from POS (context key set by pos_store.esm.js) -->
    <record id="view_partner_form_pos_efactura" model="ir.ui.view">
        <field name="name">res.partner.form.pos.efactura</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='street']" position="attributes">
                <attribute name="required">context.get('pos_efactura_check') and not parent_id</attribute>
            </xpath>
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="required">context.get('pos_efactura_check') and not parent_id</attribute>
            </xpath>
            <xpath expr="//field[@name='state_id']" position="attributes">
                <attribute name="required">context.get('pos_efactura_check') and not parent_id</attribute>
            </xpath>
            <xpath expr="//field[@name='country_id']" position="attributes">
                <attribute name="required">context.get('pos_efactura_check') and not parent_id</attribute>
            </xpath>
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute
                    name="required"
                >context.get('pos_efactura_check') and is_company and not parent_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
