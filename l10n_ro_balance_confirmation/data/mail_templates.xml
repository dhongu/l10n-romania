<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">

    <record id="mail_template_balance_confirmation" model="mail.template">
        <field name="name">Confirmare sold</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="subject">Confirmare sold</field>
        <field name="description">Sablon confirmare sold parteneri</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="partner_to">{{ object.id }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Stimate <t t-out="object.name or ''">Brandon Freeman</t>,
                    <br />
                    <br />
                    Conform dispozițiilor legale în vigoare, vă transmitem atașat confirmarea de sold.
                    Chiar dacă plata a fost deja efectuată, vă rugăm să ne transmiteți documentul completat și semnat
                    folosind funcția <strong>ReplyTo</strong> la prezentul email. În document veți găsi
                    instrucțiunile necesare completării. Nu ezitați să ne contactați dacă sunt necesare detalii.
                </p>
                <p>
                    <t t-out="user.signature" />
                </p>
            </div>
        </field>
        <field name="lang">{{ object.lang }}</field>
        <field name="auto_delete" eval="False" />
        <field
            name="report_template_ids"
            eval="[(4, ref('l10n_ro_balance_confirmation.action_report_partner_balance'))]"
        />
    </record>
</odoo>
