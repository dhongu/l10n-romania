<?xml version="1.0" ?>
<odoo>
    <record id="l10n_ro_invoice_form_view" model="ir.ui.view">
        <field name="name">l10n_ro.account.invoice.form</field>
        <field name="model">account.move</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="l10n_ro_label_length" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="l10n_ro_product_length" optional="hide" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_send_to_spv_only"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-send"
                        string="Retrimite în SPV"
                        invisible="l10n_ro_edi_state != 'invoice_refused'"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
